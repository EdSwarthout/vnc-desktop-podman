ARG BASE=localhost/u2604cc:chrome

# A browser-automation image (d_distro=chrome): Ubuntu's chrome stage (../ubuntu/Containerfile:
# Google Chrome stable, TigerVNC/noVNC, nested podman) plus Chrome Canary and tools for
# driving a browser. The base is that locally built image, so d_build builds it first.
# The build context is the repo root. One stage, tagged u2604chrome:canary:
#   canary - chrome + Google Chrome Canary, Openbox, automation tools (npm, and Python's
#            playwright in a uv-managed venv of the user's); session is an xterm
# See README.md here for how to drive the browsers (d_chrome, d_chrome_mcp).

# ---------------------------------------------------------------------------------------
# Stage "canary": Ubuntu's chrome + Chrome Canary and browser automation tools
FROM ${BASE} AS canary
USER root

# d_build passes these to every Containerfile. The user itself comes with the base image
# (as does ENV USERID, which is what ${USERID} below expands to), so they're unused here.
ARG USERID
ARG USER_UID

# google-chrome-canary: from Google's apt repository, which the stable Chrome's postinst
# set up in the base (google-chrome.sources); its own postinst adds a second sources
# file for the same repository (google-chrome-canary.sources), which is harmless.
# ffmpeg: turn screenshots or an x11grab of the display into a video
# openbox: a window manager, so browser windows can be maximised, moved and focused
#     (xdotool windowactivate needs one) and dialogs stack properly
# scrot: tests/screenshot.sh
# socat: relay the DevTools port (it only listens on 127.0.0.1) or a Unix socket
# x11-utils (xwininfo, xprop) comes with the base.
# keep list sorted
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    google-chrome-canary \
    openbox \
    scrot \
    socat \
    && { mountpoint -q /var/cache/apt-ubuntu || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# Canary needs the same flags as stable in a container (no user-namespace sandbox):
# a wrapper in /usr/local/bin shadows /usr/bin on PATH, and the menu entries are pointed
# at it (the build fails if a new Canary's .desktop files no longer have the expected
# Exec=). The default browser stays the stable Chrome.
RUN printf '#!/bin/sh\nexec /usr/bin/google-chrome-canary --no-sandbox --no-first-run --no-default-browser-check "$@"\n' \
        > /usr/local/bin/google-chrome-canary \
    && chmod +x /usr/local/bin/google-chrome-canary \
    && for f in google-chrome-canary com.google.Chrome.canary; do \
           sed -i 's|^Exec=/usr/bin/google-chrome-canary|Exec=/usr/local/bin/google-chrome-canary|' \
               /usr/share/applications/$f.desktop \
           && grep -q '^Exec=/usr/local/bin/google-chrome-canary' /usr/share/applications/$f.desktop \
           || { echo "$f.desktop: Exec= not pointed at the wrapper" >&2; exit 1; }; \
       done

# Automation tools from npm, installed in the image (/usr/local) so that nothing is
# downloaded and run at use time; all of them attach to a browser started with a DevTools
# port (d_chrome) and none brings a browser of its own:
#   chrome-devtools-mcp - Chrome DevTools for agents: MCP server, the chrome-devtools
#                         CLI (d_devtools) and agent skills (install_chrome_devtools)
#   @playwright/mcp     - MCP server (playwright-mcp) on Playwright
#   lighthouse          - page audits (performance, accessibility, SEO)
#   playwright-core, puppeteer-core - the libraries, for scripts of your own
# NODE_PATH lets a script anywhere `require` or `import` them.
# PUPPETEER_SKIP_DOWNLOAD: belt and braces, the -core packages don't download a browser.
# CHROME_DEVTOOLS_MCP_NO_*: chrome-devtools-mcp and its chrome-devtools CLI report usage
# statistics to Google and look for updates unless told not to; the version here is the
# image's, so an update notice is no use either.
ENV NODE_PATH=/usr/local/lib/node_modules \
    CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1 \
    CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS=1
RUN PUPPETEER_SKIP_DOWNLOAD=1 npm install -g --no-fund --no-audit --no-update-notifier \
        @playwright/mcp \
        chrome-devtools-mcp \
        lighthouse \
        playwright-core \
        puppeteer-core \
    && rm -rf /root/.npm \
    && for c in chrome-devtools-mcp lighthouse playwright-mcp; do command -v $c >/dev/null || { echo "no $c" >&2; exit 1; }; done

# install_chrome_devtools: for a Claude Code that runs in this instance (install_claude).
# chrome-devtools-mcp ships agent skills (how to use the chrome-devtools CLI, debugging
# accessibility, cookies, LCP, memory leaks, …); this copies them to the user's
# ~/.claude/skills, leaving skills already there alone, and prints the command that
# registers the MCP server. Run as the user at runtime, like install_claude: the home is
# a volume. A browser must be up with the DevTools port (d_chrome from outside, or
# google-chrome --remote-debugging-port=9222 --user-data-dir=$HOME/.config/chrome-automation).
RUN printf '%s\n' '#!/bin/sh' \
        'set -e' \
        'src=/usr/local/lib/node_modules/chrome-devtools-mcp/skills' \
        'mkdir -p ~/.claude/skills' \
        'for s in "$src"/*/; do' \
        '    n=$(basename "$s")' \
        '    if [ -e ~/.claude/skills/"$n" ]; then echo "kept      ~/.claude/skills/$n"' \
        '    else cp -r "$s" ~/.claude/skills/"$n"; echo "installed ~/.claude/skills/$n"; fi' \
        'done' \
        'echo "To add the MCP server to Claude Code here, run:"' \
        'echo "  claude mcp add chrome-devtools -- chrome-devtools-mcp --browserUrl http://127.0.0.1:9222 --performanceCrux=false"' \
        > /usr/local/bin/install_chrome_devtools \
    && chmod +x /usr/local/bin/install_chrome_devtools \
    && test -d /usr/local/lib/node_modules/chrome-devtools-mcp/skills

# The session: Openbox and an xterm; closing the xterm ends it, which stops the container.
# The xterm waits (up to 5 s) until Openbox manages the display: a window that maps
# while Openbox is starting can be left unmapped, i.e. an empty screen.
RUN printf '%s\n' '#!/bin/sh' \
        'openbox &' \
        'for i in $(seq 50); do' \
        '    xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id" && break' \
        '    sleep 0.1' \
        'done' \
        'exec xterm' \
        > /usr/local/bin/vnc-session

# Python: uv and a virtual environment with playwright (the library; like the npm tools
# it attaches to a running browser, see search_screenshot.py), both owned by the user
# and outside the home (a volume, which would hide them): /opt/uv/bin/uv and /opt/venv.
# The venv is first on PATH and is uv's default target (VIRTUAL_ENV), so `python3` and
# `#!/usr/bin/env python3` scripts find playwright, and the user adds packages without
# root: `uv pip install NAME` (lost when the instance is replaced: add them here to
# keep them). The system's /usr/bin/python3 and its scripts are untouched.
# UV_UNMANAGED_INSTALL: just the binaries, no changes to shell profiles and no receipt
# in the home; to update uv, rebuild (d_build_fresh). UV_NO_CACHE: nothing left in the
# build-time home, which the volume hides anyway.
RUN install -d -o ${USERID} -g ${USERID} /opt/uv /opt/venv
USER ${USERID}
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/uv/bin:${PATH}
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_UNMANAGED_INSTALL=/opt/uv/bin sh \
    && UV_NO_CACHE=1 uv venv --python /usr/bin/python3 /opt/venv \
    && UV_NO_CACHE=1 uv pip install playwright \
    && python3 -c 'import playwright' \
    && rm -rf ~/.cache ~/.config/uv ~/.local/share/uv
