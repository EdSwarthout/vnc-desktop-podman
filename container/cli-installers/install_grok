#!/bin/bash
# install_grok: xAI's Grok Build CLI (grok), run as the user: ~/.grok/bin (home volume),
# put first on PATH in ~/.bashrc; it persists and updates itself (`grok update`).
# Arguments go to the installer (a version X.Y.Z; default the latest). GROK_CHANNEL
# (stable|alpha|enterprise) is an env var.
# - The installer picks the rc file to edit from $SHELL, which podman exec doesn't set
#   (then it edits nothing): fall back to the passwd entry's shell.
# - It also links the binary as `agent`, a generic name to put first on PATH: removed.
set -ex
export SHELL="${SHELL:-$(getent passwd "$(id -u)" | cut -d: -f7)}"
curl -fsSL https://x.ai/cli/install.sh | bash -s -- "$@"
rm -f "$HOME/.grok/bin/agent"
if [ "$(readlink "$HOME/.local/bin/agent")" = "$HOME/.grok/bin/agent" ]; then
    rm -f "$HOME/.local/bin/agent"
fi
