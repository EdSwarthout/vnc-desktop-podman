# omarchy/env.rc: helpers for the Omarchy experiment (standalone; doesn't need or touch
# ../env.rc, prefix o_). Source from any cwd:  source omarchy/env.rc
#   o_build [STAGE]       build omarchy:<STAGE> (default $o_target)
#   o_run [N]             run instance N (default $o_n) of omarchy:$o_target
#   o_logs, o_exec CMD…   (o_exec: with the session's Wayland/Hyprland/D-Bus env)
#   o_screenshot [FILE]   grim of the output, copied to FILE (default /tmp/o_shot-N.png)
#   o_vnc                 vncviewer on the instance's port
#   o_rm [-f]             remove the container and its home (asks unless -f)
o_src=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
: "${o_target:=wayvnc}" "${o_n:=1}" "${o_user:=${d_user:-$(id -un)}}"
: "${o_dir:=${d_dir:-$HOME/Containers}}"
o_cache=${o_cache:-/var/cache/apt-archlinux}
[ -n "${container:-}" ] && o_dir=$HOME/Containers

# the vkms card (its number depends on module load order; card0 is often a real GPU)
_o_vkms_card() {
    local c
    for c in /sys/class/drm/card[0-9]*; do
        case $(readlink -f "$c") in */vkms/drm/card[0-9]*) basename "$c"; return;; esac
    done
}

_o_names() {   # name, home and port of instance $o_n
    if [ -n "${container:-}" ]; then
        o_name=${D_NAME:-$HOSTNAME}_${o_n}o
        o_home=$o_dir/$o_name
    else
        o_name=cc${o_n}o
        o_home=$o_dir/omarchy$o_n
    fi
    o_port=$((7100 + o_n))
}

o_build() {
    local stage=${1:-$o_target} cache=()
    [ -d "$o_cache" ] && cache=(-v "$o_cache:/var/cache/apt-archlinux")
    [ -f "$o_src/rootfs.tar" ] || { echo "no $o_src/rootfs.tar: run $o_src/extract.sh" >&2; return 1; }
    local cmd=(podman build --security-opt label=disable "${cache[@]}"
               --build-arg USERID="$o_user" --build-arg USER_UID="$(id -u)"
               --target "$stage" -t "omarchy:$stage" "$o_src")
    echo "${cmd[*]}"; "${cmd[@]}"
}

o_run() {
    [ -n "${1:-}" ] && o_n=$1
    _o_names
    local card=${o_card:-$(_o_vkms_card)}
    [ -n "$card" ] || { echo "no vkms card in /sys/class/drm (host: sudo modprobe vkms)" >&2; return 1; }
    [ -e "/dev/dri/$card" ] || { echo "/dev/dri/$card isn't available here" >&2; return 1; }
    case $(readlink -f "/sys/class/drm/$card") in
        */vkms/*) ;;
        *) [ -n "${o_allow_gpu:-}" ] || { echo "$card is not vkms (set o_allow_gpu=1 to use it anyway)" >&2; return 1; };;
    esac
    mkdir -p "$o_home"
    local cache=()
    [ -d "$o_cache" ] && cache=(-v "$o_cache:/var/cache/apt-archlinux")
    local cmd=(podman run -d --replace --init --name "$o_name"
               --userns=keep-id --security-opt label=disable
               --device "/dev/dri/$card" --group-add keep-groups
               --tz=local --shm-size=2g --tmpfs=/tmp --pids-limit 16384
               -p "$o_port:5900" -v "$o_home:/home/$o_user" "${cache[@]}"
               ${o_run_opts:-} "omarchy:$o_target")
    echo "${cmd[*]}"; "${cmd[@]}"
}

o_logs() { _o_names; podman logs "$@" "$o_name"; }

# podman exec as the user, with the environment of the session (omarchy-session's
# Hyprland), minus the ambient caps podman exec gives
o_exec() {
    _o_names
    podman exec -i "$o_name" bash -c '
        p=$(pgrep -x -u "$(id -u)" Hyprland | head -1)
        [ -n "$p" ] || { echo "no Hyprland running" >&2; exit 1; }
        while IFS= read -r -d "" v; do
            case $v in XDG_RUNTIME_DIR=*|WAYLAND_DISPLAY=*|HYPRLAND_INSTANCE_SIGNATURE=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_*=*|OMARCHY_*=*) export "$v";; esac
        done < /proc/$p/environ
        [ -n "${WAYLAND_DISPLAY:-}" ] || export WAYLAND_DISPLAY=$(cd "$XDG_RUNTIME_DIR" && ls wayland-* | grep -v lock | head -1)
        [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || export HYPRLAND_INSTANCE_SIGNATURE=$(ls "$XDG_RUNTIME_DIR/hypr" | head -1)
        exec setpriv --inh-caps=-all --ambient-caps=-all "$@"' bash "$@"
}

o_screenshot() {
    _o_names
    local f=${1:-/tmp/o_shot-$o_n.png}
    o_exec grim /tmp/o_shot.png && podman cp "$o_name:/tmp/o_shot.png" "$f" && echo "$f"
}

o_vnc() { _o_names; vncviewer "127.0.0.1::$o_port" & }

o_rm() {
    local force=
    [ "${1:-}" = -f ] && { force=1; shift; }
    [ -n "${1:-}" ] && o_n=$1
    _o_names
    if [ -z "$force" ]; then
        read -r -p "remove $o_name and $o_home? [y/N] " a; [ "$a" = y ] || return 1
    fi
    podman rm -f -t 2 "$o_name" || podman rm -f -t 2 "$o_name"
    podman unshare rm -rf "$o_home"
}
