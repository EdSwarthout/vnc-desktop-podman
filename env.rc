# -*- sh -*-

# Defaults. Don't edit them for a local setup: .env next to this file (gitignored) is
# sourced below and can set any of them, e.g. `d_dir=/srv/containers`, as well as
# `export VNC_PASSWORD=...`.

# buildtime
# Distro, i.e. which <distro>/Containerfile: ubuntu (Ubuntu 26.04) | debian (Debian 13
# trixie). Override per command: d_distro=debian d_target=gnome d_build
d_distro=ubuntu
# Per distro: base image, image name (tagged <image>:$d_target, e.g. u2604cc:xfce) and
# stages in Containerfile order. Setting d_base or d_image (e.g. in .env) overrides
# them for whichever distro is selected.
declare -gA d_bases=([ubuntu]=docker.io/library/ubuntu:26.04 [debian]=docker.io/library/debian:trixie)
declare -gA d_images=([ubuntu]=u2604cc [debian]=d13cc)
d_targets_ubuntu=(base vnc chrome xfce lxqt gnome kde mate cinnamon)
d_targets_debian=(base vnc chrome gnome)
unset d_base d_image
# Stage to build and run: base (headless + nested podman) | vnc (xterm) | chrome |
# desktops: ubuntu xfce | lxqt | gnome | kde | mate | cinnamon; debian gnome.
# Override per command: d_target=lxqt d_build
d_target=xfce
d_dir=/mnt/hwd23data/sw/docker
# Container user: d_build creates it with this name and the UID of whoever builds, so
# with keep-id (below) it is you, and owns the home volume.
d_user=ed
# apt .debs, one cache per distro (their .debs can share a file name but not the
# contents), NFS-exported to other machines. On the host: Ubuntu's
# $d_dir/apt-cache/archives, others' $d_dir/apt-cache-<distro>/archives; .env may set
# one, e.g. d_aptcaches[debian]=/srv/apt-debian. Inside an instance: the ones d_run
# mounted there, /var/cache/apt-<distro>. d_build mounts the distro's at
# /var/cache/apt-<distro> (where the image's apt keeps its .debs); d_run mounts every
# distro's that exists, so a nested build of either distro finds its own.
declare -gA d_aptcaches=()
# Home dir prefix per distro, instance N's home is <prefix>N: default $d_dir/<image name>
# (u2604cc1, d13cc1). .env may set one, e.g. d_homes0[debian]=/srv/deb/d13cc.
declare -gA d_homes0=()
# Most processes + threads an instance may have, nested instances included (they run in
# their parent's cgroup). podman's default, 2048, is too few for several nested desktops
# plus an Electron app ("can't spawn worker thread: Resource temporarily unavailable").
# -1: no limit. Applies when d_run creates the container.
d_pids_limit=16384
# What d_all runs for each instance once its desktop is up: any shell command, e.g.
# d_novnc, or 'podman exec "$d_name" ...'; empty for nothing. Override per command:
# d_all_cmd=d_novnc d_all 11
d_all_cmd=d_vnc


d_run_opts=("-d")

# Give networking options to parent for debug. Remove for production
d_run_opts=("-d" "--network=pasta:--map-gw,-T,5201" "--cap-add=NET_RAW")

# Load VNC_PASSWORD and local settings from .env next to this file (works from any cwd)
_d_rcdir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$_d_rcdir/.env" ] && source "$_d_rcdir/.env"

# runtime
# Instance N of a distro is <d_name0>N<first letter of d_distro>: cc1u, cc1d.
d_name0=cc
d_ports=(5901 6080)
# Host ports of instance N are <base>+N, with bases per distro so that cc1u and cc1d can
# run side by side: VNC 6900+N / 6950+N, noVNC 6080+N / 6130+N. So N is 1-49.
declare -gA d_vnc_ports0=([ubuntu]=6900 [debian]=6950)
declare -gA d_novnc_ports0=([ubuntu]=6080 [debian]=6130)
d_instance=${d_instance:-0}   # keep the current selection when re-sourced

# Inside an instance ($container set, nested podman): the host paths aren't visible.
# Instance N is <this instance>_N<letter> (e.g. cc2u_1d, or cc2u_1d_1u one level deeper),
# home ~/Containers/<its name>; the apt caches are this instance's mounts. Its ports
# are only published inside this instance. This instance's name comes from $D_NAME (set
# by d_run), as nested instances share the hostname; older instances fall back to it.
if [ -n "${container:-}" ]; then
    d_dir=/home/$d_user/Containers
    d_name0=${D_NAME:-$HOSTNAME}_

#  By default, Podman passes --no-map-gw to pasta, preventing the container from reaching the host's IP address or gateway.
#  To ping the parent machine, start the container with --network=pasta:--map-gw and ping host.containers.internal
#  -T,5201 connect to the parent's iperf3 server via 127.0.0.1 on port 5201
    d_run_opts=("-d" "--network=pasta:--map-gw,-T,5201" "--cap-add=NET_RAW")
fi

# d_select N: target instance N. Only the number is kept: its name (d_name), home
# (d_home) and host ports (h_ports) follow d_distro, and are worked out again by each
# function that uses them, so `d_select 1; d_distro=debian d_run` runs cc1d.
d_select() {
    [[ $1 =~ ^[1-9][0-9]*$ ]] && [ "$1" -le 49 ] || { echo "usage: d_select N  (1 <= N <= 49)" >&2; return 1; }
    d_instance=$1
    _d_names || return
    echo "$d_name $d_home ports ${h_ports[*]}"
}

# _d_names [N]: d_name, d_home and h_ports of instance N (default: the selected one) of
# $d_distro. Nested, the home is ~/Containers/<name>.
_d_names() {
    local n=${1:-$d_instance}
    _d_distro || return
    d_name=${d_name0}$n${d_distro:0:1}
    if [ -n "${container:-}" ]; then
        d_home=$d_dir/$d_name
    else
        local h0=${d_homes0[$d_distro]:-$d_dir/${d_images[$d_distro]}}
        d_home=$h0$n
    fi
    h_ports=( $(( d_vnc_ports0[$d_distro] + n )) $(( d_novnc_ports0[$d_distro] + n )) )
}

# d_run_new: select the next free instance number of $d_distro after the current one:
# no container of that name and no home dir yet, so a following d_run (--replace)
# can't take down an existing instance.
d_run_new() {
    local n=$(( d_instance + 1 ))
    while _d_names "$n" && { podman container exists "$d_name" || [ -e "$d_home" ]; }; do
        n=$(( n + 1 ))
        [ "$n" -le 49 ] || { echo "d_run_new: no free instance number" >&2; return 1; }
    done
    d_select "$n"
}

_d_need_instance() {
    [ "${d_instance:-0}" -gt 0 ] || { echo "no instance selected: run d_select N or d_run_new" >&2; return 1; }
    _d_names
}

# _d_distro: the selected distro's settings, read at call time so that a per-command
# d_distro=… works: _d_cf (Containerfile), _d_base, _d_image, _d_aptcache, _d_targets.
_d_distro() {
    _d_cf=$_d_rcdir/$d_distro/Containerfile
    if [ -z "${d_images[$d_distro]:-}" ] || [ ! -f "$_d_cf" ]; then
        echo "unknown d_distro '$d_distro' (${!d_images[*]})" >&2; return 1
    fi
    _d_base=${d_base:-${d_bases[$d_distro]}}
    _d_image=${d_image:-${d_images[$d_distro]}}
    _d_aptcache=$(_d_aptcache_of "$d_distro")
    local -n t=d_targets_$d_distro
    _d_targets=("${t[@]}")
}

# _d_aptcache_of DISTRO: that distro's apt cache directory (see d_aptcaches)
_d_aptcache_of() {
    local sfx=-$1; [ "$1" = ubuntu ] && sfx=
    if [ -n "${d_aptcaches[$1]:-}" ]; then echo "${d_aptcaches[$1]}"
    elif [ -n "${container:-}" ]; then echo "/var/cache/apt-$1"
    else echo "$d_dir/apt-cache$sfx/archives"
    fi
}

# _d_need_target: d_target is a stage of the selected distro's Containerfile
_d_need_target() {
    _d_distro || return
    [[ " ${_d_targets[*]} " == *" $d_target "* ]] && return
    echo "d_target '$d_target' isn't a $d_distro stage (${_d_targets[*]})" >&2
    return 1
}

export PODMAN_USERNS=keep-id
# or create ~/.config/containers/containers.conf with:
#[containers]
#userns = "keep-id"

d_0() {
    _d_distro || return
    podman pull "$_d_base"
}

# d_build [podman build options...]: extra args are passed to podman build
# (the context is this directory, so both Containerfiles COPY the shared start.sh etc.)
d_build() {
    _d_need_target || return
    [ -d "$_d_aptcache" ] || { echo "d_build: no $d_distro apt cache at $_d_aptcache (create it; inside an instance, recreate that instance from the host with d_run)" >&2; return 1; }
    local cmd=(build "$@" -t "$_d_image:$d_target" -f "$_d_cf" --target "$d_target" --build-arg BASE="$_d_base"
               --build-arg USERID="$d_user" --build-arg USER_UID="$(id -u)"
               --security-opt label=disable
               -v "$_d_aptcache":/var/cache/apt-"$d_distro" "$_d_rcdir")
    echo podman "${cmd[@]}"
    podman "${cmd[@]}"
}

# d_build_fresh: pull a newer base if there is one and re-run every layer, so
# apt-get upgrade and the Chrome download aren't served from the layer cache
d_build_fresh() {
    d_build --pull=newer --no-cache "$@"
}

# VNC password: never passed in the environment, where it would stay visible in `podman
# inspect` and be inherited by everything in the desktop. While the home has no
# ~/.config/tigervnc/passwd, d_run writes $VNC_PASSWORD to passwd.init next to it (mode
# 600); start.sh turns that into passwd on first boot and deletes it. Nested, with no
# $VNC_PASSWORD, the new instance gets a copy of this instance's passwd.
_d_vnc_password() {
    local vncdir=$d_home/.config/tigervnc
    [ -s "$vncdir/passwd" ] && return
    if [ -n "${VNC_PASSWORD:-}" ]; then
        mkdir -p "$vncdir" && ( umask 077; printf '%s\n' "$VNC_PASSWORD" > "$vncdir/passwd.init" )
    elif [ -n "${container:-}" ] && [ -s ~/.config/tigervnc/passwd ]; then
        mkdir -p "$vncdir" && cp -p ~/.config/tigervnc/passwd "$vncdir/passwd"
    else
        echo "d_run: $vncdir/passwd doesn't exist and VNC_PASSWORD isn't set (see .env in the README)" >&2
        return 1
    fi
}

# Ports published on all interfaces, so only run on local LAN behind firewall
#
# /dev/fuse (fuse-overlayfs fallback) and /dev/net/tun (pasta) are for nested podman,
# which every stage has. unmask=/proc/* lets nested
# containers mount their own /proc (the kernel refuses while parts of it are masked);
# low risk rootless, as the unmasked files still belong to the host's real root.
d_run() {
    _d_need_instance || return
    _d_need_target || return
    mkdir -p "$d_home" || return
    if [ "$d_target" != base ]; then _d_vnc_password || return; fi   # base: no VNC
    # Nested (inside an instance, $container set): utsns = "host", so no --hostname
    local hn=(--hostname "$d_name")
    [ -n "${container:-}" ] && hn=()
    # Every distro's apt cache that exists, for nested builds (see d_aptcaches)
    local apt=() d c
    for d in "${!d_images[@]}"; do
        c=$(_d_aptcache_of "$d")
        if [ -d "$c" ]; then apt+=(-v "$c":/var/cache/apt-"$d")
        else echo "d_run: no $d apt cache at $c; not mounted" >&2; fi
    done
    # --tz=local: the instance uses the host's timezone (a nested one gets its parent's).
    # D_NAME: the instance's own name, so a nested env.rc can name its children <name>_N.
    local cmd=(run "${d_run_opts[@]}" --init --replace --name "$d_name" "${hn[@]}" --tz=local -e D_NAME="$d_name"
               --shm-size=2g --tmpfs=/tmp --pids-limit "$d_pids_limit"
               --security-opt label=disable --security-opt 'unmask=/proc/*'
               --device /dev/fuse --device /dev/net/tun
               -p "${h_ports[0]}:${d_ports[0]}"
               -p "${h_ports[1]}:${d_ports[1]}"
               -v "$d_home":/home/"$d_user"
               "${apt[@]}"
               "$_d_image:$d_target")
    echo podman "${cmd[@]}"
    podman "${cmd[@]}"
}

d_vnc() {
    _d_need_instance || return
    command -v vncviewer >/dev/null || { echo "d_vnc: no vncviewer (TigerVNC) here; use d_novnc" >&2; return 1; }
    echo vncviewer :${h_ports[0]} -Shared=1 -passwd "$d_home/.config/tigervnc/passwd"
    vncviewer :${h_ports[0]} -Shared=1 -passwd "$d_home/.config/tigervnc/passwd"
}

# d_novnc: open the selected instance's noVNC page in the default browser (it asks for
# the VNC password). Without xdg-open, just print the URL. 127.0.0.1, not localhost:
# in instances from images before websockify listened on IPv6 too, the published port
# accepts a connection via localhost = ::1 and then resets it.
d_novnc() {
    _d_need_instance || return
    local url="http://127.0.0.1:${h_ports[1]}/vnc.html"
    echo "$url"
    command -v xdg-open >/dev/null || { echo "d_novnc: no xdg-open here; open the URL above in a browser" >&2; return 1; }
    xdg-open "$url"
}

d_logs() {
    _d_need_instance || return
    podman logs -f "$d_name"
}

# d_all N [STAGE...]: for each stage of $d_distro (default: all, in Containerfile order) d_build it,
# then d_select N, N+1, … and d_run it there, and run $d_all_cmd (default d_vnc, a
# viewer) in the background once the instance's VNC password file exists (not for
# base: no VNC). The command is eval'ed in a subshell with that instance selected and
# d_target set to its stage, so it can use d_* functions and $d_name, $d_home,
# ${h_ports[@]}. N is required because d_run replaces an existing instance with that
# number. Leaves the last instance selected but d_target at its env.rc value, so pass
# d_target=<stage> to a later d_run for it. The command's output goes to
# /tmp/d_all-<name>.log. Stops at the first failed build or run.
d_all() {
    _d_distro || return
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || { echo "usage: d_all N [STAGE...]  (instances N, N+1, …; default stages: ${_d_targets[*]})" >&2; return 1; }
    local n=$1; shift
    local stages=("$@"); [ ${#stages[@]} -gt 0 ] || stages=("${_d_targets[@]}")
    local d_target
    for d_target in "${stages[@]}"; do
        echo "=== $d_target"
        d_build || { echo "d_all: d_build $d_target failed" >&2; return 1; }
        d_select "$n" || return
        d_run || { echo "d_all: d_run $d_target failed" >&2; return 1; }
        if [ "$d_target" != base ] && [ -n "${d_all_cmd:-}" ]; then
            # Background subshell: keeps this instance's selection; waits up to 60 s
            # for first boot to write the password file.
            ( for _ in $(seq 60); do [ -s "$d_home/.config/tigervnc/passwd" ] && break; sleep 1; done
              sleep 2; eval "$d_all_cmd" ) > "/tmp/d_all-$d_name.log" 2>&1 &
        fi
        n=$((n + 1))
    done
}

# d_screenshots N [STAGE...]: retake docs/$d_distro/<stage>.png, the picture of each stage's
# desktop as it first comes up (default stages: all but base, which is headless, and
# chrome, which starts like vnc). For each stage: d_build, d_run it on instance N with
# a new home, wait for the desktop to settle ($d_shot_wait seconds, default 30), run
# tests/screenshot.sh in it, then remove the container and that home again. N must be
# unused (no container, no home dir), so nothing of yours is replaced or deleted. A
# stage without a screenshot tool (vnc) gets scrot installed in the throwaway container.
# Runs in a subshell: your instance selection and d_target are left alone.
d_screenshots() (
    _d_distro || return
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || { echo "usage: d_screenshots N [STAGE...]  (N: an unused instance number)" >&2; return 1; }
    n=$1; shift
    stages=("$@")
    if [ ${#stages[@]} -eq 0 ]; then
        for t in "${_d_targets[@]}"; do
            case $t in base|chrome) ;; *) stages+=("$t") ;; esac
        done
    fi
    d_select "$n" >/dev/null || return
    if podman container exists "$d_name" || [ -e "$d_home" ]; then
        echo "d_screenshots: instance $n is in use ($d_name or $d_home exists); pick an unused number" >&2
        return 1
    fi
    docs=$_d_rcdir/docs/$d_distro
    mkdir -p "$docs" || return
    shot() { podman exec "$d_name" bash "/home/$d_user/.d_screenshot.sh" "/home/$d_user/.d_screenshot.png" >/dev/null; }
    rc=0
    for d_target in "${stages[@]}"; do
        echo "=== $d_target"
        if d_build >/dev/null && d_run >/dev/null; then
            # first boot writes the VNC password file just before starting the desktop
            for _ in $(seq 60); do [ -s "$d_home/.config/tigervnc/passwd" ] && break; sleep 1; done
            sleep "${d_shot_wait:-30}"
            cp "$_d_rcdir/tests/screenshot.sh" "$d_home/.d_screenshot.sh"
            shot; s=$?
            if [ "$s" -eq 2 ]; then
                echo "no screenshot tool in $d_target: installing scrot in $d_name"
                podman exec -u root "$d_name" sh -c 'apt-get update -qq && apt-get install -y -qq --no-install-recommends scrot' >/dev/null
                shot; s=$?
            fi
            if [ "$s" -eq 0 ] && cp "$d_home/.d_screenshot.png" "$docs/$d_target.png"; then
                echo "$docs/$d_target.png"
            else
                echo "d_screenshots: no screenshot of $d_target" >&2; rc=1
            fi
        else
            echo "d_screenshots: building or running $d_target failed" >&2; rc=1
        fi
        podman rm -f -t 2 "$d_name" >/dev/null 2>&1
        # the home may hold files owned by sub-IDs (nested podman storage)
        [ -e "$d_home" ] && podman unshare rm -rf "$d_home"
    done
    return $rc
)
