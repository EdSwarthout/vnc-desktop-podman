# -*- sh -*-

# Defaults. Don't edit them for a local setup: .env next to this file (gitignored) is
# sourced below and can set any of them, e.g. `d_dir=/srv/containers`, as well as
# `export VNC_PASSWORD=...`.

# buildtime
# Distro, i.e. which container/<distro>/Containerfile has the stages base, vnc and
# browser: ubuntu (Ubuntu 26.04) | debian (Debian 13 trixie) | fedora (Fedora 45) |
# archlinux (Arch Linux, rolling).
# Override per command: d_distro=debian d_target=gnome d_build
d_distro=ubuntu
# Per distro: base image, image name and version (tagged <image>:<d_target>-<version>,
# e.g. vnc-desktop-ubuntu:lxqt-2604; no version, no suffix: vnc-desktop-archlinux:openbox).
# Setting d_base or d_image (e.g. in .env) overrides them for whichever distro is
# selected (d_base: the pulled image the base stage starts from).
declare -gA d_bases=([ubuntu]=docker.io/library/ubuntu:26.04 [debian]=docker.io/library/debian:trixie
                     [fedora]=registry.fedoraproject.org/fedora:45
                     [archlinux]=docker.io/library/archlinux:latest)
declare -gA d_images=([ubuntu]=vnc-desktop-ubuntu [debian]=vnc-desktop-debian
                      [fedora]=vnc-desktop-fedora [archlinux]=vnc-desktop-archlinux)
# Keep in step with d_bases (Arch Linux is rolling: none). .env may override one.
declare -gA d_versions=([ubuntu]=2604 [debian]=13 [fedora]=45)
# Targets (d_target), in three layers, each built on the one before it:
# - d_stages: the distro's own stages, in container/<distro>/Containerfile;
# - a desktop, e.g. lxqt: container/<desktop>/Containerfile (d_dirs maps a target to another
#   directory: devtools is in chrome/), stage <distro>, built on <image>:browser[-<version>];
# - an agent desktop <desktop>-<agent>, e.g. lxqt-opencode: container/<agent>/Containerfile
#   (an agent of d_agents), stage <distro>, built on <image>:<desktop>[-<version>].
# d_build builds the layers below first. d_targets_<distro> lists what that distro has,
# in build order (d_all, d_test default to all of them); any other <desktop>-<agent>
# of a listed desktop works too where the agent's Containerfile has a <distro> stage.
d_stages=(base vnc browser)
# Maps targets or distros whose Containerfile lives in another directory under container/.
declare -gA d_dirs=([devtools]=chrome [ubuntu]=deb [debian]=deb)
d_agents=(claude antigravity opencode)
# shellcheck disable=SC2034  # referenced via nameref d_targets_$d_distro in _d_distro
d_targets_ubuntu=(base vnc browser xfce lxqt gnome kde mate cinnamon devtools
                  lxqt-opencode lxqt-antigravity gnome-opencode gnome-antigravity
                  gnome-claude)
# shellcheck disable=SC2034
d_targets_debian=(base vnc browser gnome)
# shellcheck disable=SC2034
d_targets_fedora=(base vnc browser xfce lxqt lxqt-opencode lxqt-antigravity)
# shellcheck disable=SC2034
d_targets_archlinux=(base vnc browser openbox)
# Arch Linux is amd64 only (Docker Hub's archlinux has no arm64): on arm64 it is no
# distro at all, so no list has it (d_run's apt cache mounts, d_test's checks, …).
if [ "$(uname -m)" = aarch64 ]; then
    unset 'd_bases[archlinux]' 'd_images[archlinux]' d_targets_archlinux
fi
unset d_base d_image
# Image description, d_build's org.opencontainers.image.description label:
# "<d_desc_distros of the distro>: <target text>", the target text being
# d_descs[<distro>:<target>], else d_descs[<target>]; for <desktop>-<agent>,
# "<the agent's text>; <the desktop's text>". Setting d_description (per command or in
# .env) replaces the whole text.
declare -gA d_desc_distros=([ubuntu]="Ubuntu 26.04" [debian]="Debian 13 (trixie)"
                            [fedora]="Fedora 45" [archlinux]="Arch Linux")
declare -gA d_descs=(
    [base]="headless, with nested rootless podman"
    [vnc]="xterm session over TigerVNC/noVNC, with nested rootless podman"
    [browser]="Google Chrome and CLI installers (Claude Code, Antigravity, OpenCode, Grok, T3 Code) in an xterm session over TigerVNC/noVNC, with nested rootless podman"
    [archlinux:browser]="Chromium and CLI installers (Claude Code, Antigravity, OpenCode, Grok, T3 Code) in an xterm session over TigerVNC/noVNC, with nested rootless podman"
    [xfce]="XFCE desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [lxqt]="LXQt desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [ubuntu:gnome]="GNOME Flashback desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [debian:gnome]="GNOME Shell desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [kde]="KDE Plasma (X11) desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [mate]="MATE desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [cinnamon]="Cinnamon desktop over TigerVNC/noVNC, with Chrome, CLI installers and nested rootless podman"
    [openbox]="Openbox desktop over TigerVNC/noVNC, with Chromium, CLI installers and nested rootless podman"
    [devtools]="browser automation: Chrome Canary, chrome-devtools-mcp, Playwright, Puppeteer and Lighthouse in an Openbox session over TigerVNC/noVNC"
    [claude]="Claude desktop app"
    [opencode]="OpenCode Desktop and CLI"
    [antigravity]="Google Antigravity App and Python SDK"
)
unset d_description
# Stage to build and run: base (headless + nested podman) | vnc (xterm) | browser |
# desktops: ubuntu xfce | lxqt | gnome | kde | mate | cinnamon; debian gnome; fedora
# xfce | lxqt; archlinux openbox | devtools (ubuntu) | agent desktops <desktop>-<agent>, agent claude |
# antigravity | opencode, e.g. lxqt-opencode, gnome-opencode, gnome-claude.
# Override per command: d_target=lxqt d_build
d_target=lxqt
# Host directory for instance homes and per-distro package caches; override in .env.
d_dir=${XDG_DATA_HOME:-$HOME/.local/share}/vnc-desktop
# Container user: d_build creates it with this name and the UID/GID of whoever builds, so
# with keep-id (below) it is you, and owns the home volume.
d_user=${USER:-ed}
# Host interface to bind published VNC/noVNC ports to in d_run. Empty binds all
# interfaces (for a trusted LAN); set d_bind=127.0.0.1 in .env for localhost-only
# access (e.g. over an SSH tunnel).
d_bind=
# apt .debs, one cache per distro (their .debs can share a file name but not the
# contents), NFS-exported to other machines. archlinux's holds pacman's packages and
# fedora's dnf's rpms and metadata instead, under the same names (apt-cache-archlinux,
# /var/cache/apt-archlinux, apt-cache-fedora, …). On the host:
# $d_dir/apt-cache-<distro>/archives; .env may set one, e.g. d_aptcaches[debian]=/srv/apt-debian. Inside an instance: the ones d_run
# mounted there, /var/cache/apt-<distro>. d_build mounts the distro's at
# /var/cache/apt-<distro> (where the image's apt keeps its .debs); d_run mounts every
# distro's that exists, so a nested build of either distro finds its own.
declare -gA d_aptcaches=()
# Directory holding a distro's homes (key <distro>), default $d_dir; an instance's home
# is <that dir>/<instance name>, e.g. $d_dir/vnc-desktop-ubuntu-lxqt-2604-6901.
# .env may set one, e.g. d_homes0[debian]=/srv/deb.
declare -gA d_homes0=()
# Most processes + threads an instance may have, nested instances included (they run in
# their parent's cgroup). podman's default, 2048, is too few for several nested desktops
# plus an Electron app ("can't spawn worker thread: Resource temporarily unavailable").
# -1: no limit. Applies when d_run creates the container.
d_pids_limit=16384
# What d_all runs for each instance once its desktop is up: any shell command, e.g.
# d_novnc, or 'podman exec "$d_name" ...'; empty for nothing. Override per command:
# d_all_cmd=d_novnc d_all 11
d_all_cmd=d_vnc

# Extra `podman run` options for d_run (-d: detached) and d_run_cmd (which drops -d).
# --cap-add=NET_RAW is needed for ping (start.sh and d_exec strip it from ambient caps
# so bwrap/GTK keep working, while /usr/bin/ping keeps it via file caps).
# For host-network debugging (reaching host.containers.internal or host loopback port
# 5201 via pasta), override in .env:
#   d_run_opts=("-d" "--network=pasta:-T,5201,--map-gw" "--cap-add=NET_RAW")
# Note: in pasta, -T 5201 forwards container 127.0.0.1:5201 to host 127.0.0.1:5201
# (put -T before --map-gw on podman 4.9), whereas --map-gw routes to the host gateway.
d_run_opts=("-d" "--cap-add=NET_RAW")

# Load VNC_PASSWORD and local settings from .env next to this file (works from any cwd)
_d_rcdir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# Containerfiles and the files they COPY (start.sh, …); the build context is still
# this directory, so that LICENSE and user_files/<distro>/ are in it too.
_d_cdir=$_d_rcdir/container
# shellcheck source=/dev/null
[ -f "$_d_rcdir/.env" ] && source "$_d_rcdir/.env"

# runtime
# Instance N is named after its image and tag, ending in its VNC host port (below):
# <image>-<tag>-<VNC port>, e.g. vnc-desktop-ubuntu-lxqt-2604-6901,
# vnc-desktop-fedora-lxqt-antigravity-45-7207 (the container, its hostname and its home
# under $d_dir). So every target has its own instance and home, and the names follow
# d_target: d_target=lxqt-opencode d_rm 1. Ports are per distro (or per devtools/agent
# layer), not per target: two desktops of one distro on the same N want the same ports
# (names ending alike); use different N to run them at once (d_run_new skips used ones).
d_ports=(5901 6080)
# Host ports of instance N are <base>+N, with bases per distro, or per layer, so that
# they can all run side by side: VNC 6900+N (ubuntu) / 6950+N (debian) / 7000+N
# (devtools) / 7050+N (archlinux) / 7150+N (opencode) / 7200+N (antigravity) / 7350+N
# (fedora) / 7400+N (claude), noVNC 6080+N / 6130+N / 6180+N / 6230+N / 6330+N / 6380+N /
# 6530+N / 6580+N. So N is
# 1-49. (7100+N / 6280+N are omarchy's.) A layer's instance N on two distros shares the
# ports.
declare -gA d_vnc_ports0=([ubuntu]=6900 [debian]=6950 [archlinux]=7050 [fedora]=7350
                          [devtools]=7000 [opencode]=7150 [antigravity]=7200 [claude]=7400)
declare -gA d_novnc_ports0=([ubuntu]=6080 [debian]=6130 [archlinux]=6230 [fedora]=6530
                            [devtools]=6180 [opencode]=6330 [antigravity]=6380 [claude]=6580)
d_instance=${d_instance:-0}   # keep the current selection when re-sourced

# Inside an instance ($container set, nested podman): the host paths aren't visible.
# Instance N is <this instance>_<image>-<tag>-<VNC port> (e.g.
# vnc-desktop-ubuntu-lxqt-2604-6902_vnc-desktop-debian-gnome-13-6951), home
# ~/Containers/<its name>; the apt caches are this instance's mounts. Its ports are only published inside this instance.
# This instance's name comes from $D_NAME (set by d_run), as nested instances share the
# hostname.
if [ -n "${container:-}" ]; then
    d_dir=/home/$d_user/Containers
fi

# d_select N: target instance N. Only the number is kept: its name (d_name), home
# (d_home) and host ports (h_ports) follow d_distro and d_target's layer, and are worked
# out again by each function that uses them, so `d_select 1; d_distro=debian d_target=gnome
# d_run` runs vnc-desktop-debian-gnome-13-6951, and `d_select 1; d_target=lxqt-opencode
# d_run` vnc-desktop-ubuntu-lxqt-opencode-2604-7151.
d_select() {
    [[ $1 =~ ^[1-9][0-9]*$ ]] && [ "$1" -le 49 ] || { echo "usage: d_select N  (1 <= N <= 49)" >&2; return 1; }
    d_instance=$1
    _d_names || return
    echo "$d_name $d_home ports ${h_ports[*]}"
}

# _d_names [N]: d_name, d_home and h_ports of instance N (default: the selected one) of
# $d_distro and $d_target's layer. Nested, the home is ~/Containers/<name>.
_d_names() {
    local n=${1:-$d_instance}
    _d_distro || return
    local k=${_d_layer:-$d_distro}
    h_ports=( $(( ${d_vnc_ports0[$k]:-${d_vnc_ports0[$d_distro]}} + n ))
              $(( ${d_novnc_ports0[$k]:-${d_novnc_ports0[$d_distro]}} + n )) )
    local base=$_d_image-$_d_tag-${h_ports[0]}
    if [ -n "${container:-}" ]; then
        d_name=${D_NAME:-$HOSTNAME}_$base
        d_home=$d_dir/$d_name
    else
        d_name=$base
        d_home=${d_homes0[$d_distro]:-$d_dir}/$d_name
    fi
}

# d_run_new: select the next free instance number of $d_distro and d_target after the
# current one: no container or home dir yet whose name ends in its VNC port (this
# target's, or another target's on the same ports), so a following d_run (--replace)
# can't take down an existing instance and the ports are free.
_d_port_used() {
    local h
    podman ps -a --format '{{.Names}}' | grep -q -- "-$1\$" && return 0
    for h in "${d_home%/*}"/*-"$1"; do [ -e "$h" ] && return 0; done
    return 1
}
d_run_new() {
    local n=$(( d_instance + 1 ))
    while _d_names "$n" && { podman container exists "$d_name" || [ -e "$d_home" ] || _d_port_used "${h_ports[0]}"; }; do
        n=$(( n + 1 ))
        [ "$n" -le 49 ] || { echo "d_run_new: no free instance number" >&2; return 1; }
    done
    d_select "$n"
}

_d_need_instance() {
    [ "${d_instance:-0}" -gt 0 ] || { echo "no instance selected: run d_select N or d_run_new" >&2; return 1; }
    _d_names
}

# _d_distro: the selected distro's and target's settings, read at call time so that a
# per-command d_distro=… or d_target=… works: _d_image, _d_tag (<d_target>[-<version>]),
# _d_aptcache, _d_targets, and
# for d_target: _d_layer (devtools or the agent; empty for the distro's stages and the
# desktops), _d_cf (Containerfile), _d_stage (its stage), _d_parent (the target it's
# built on; empty for the distro's stages) and _d_base (the image it starts from).
_d_distro() {
    local ddir=${d_dirs[$d_distro]:-$d_distro}
    if [ -z "${d_images[$d_distro]:-}" ] || [ ! -f "$_d_cdir/$ddir/Containerfile" ]; then
        echo "unknown d_distro '$d_distro' (${!d_images[*]})" >&2; return 1
    fi
    _d_image=${d_image:-${d_images[$d_distro]}}
    local v=${d_versions[$d_distro]:-}
    _d_tag=$d_target${v:+-$v}
    _d_aptcache=$(_d_aptcache_of "$d_distro")
    local -n t=d_targets_$d_distro
    _d_targets=("${t[@]}")
    _d_layer='' _d_parent='' _d_stage=$d_distro
    if [[ " ${d_stages[*]} " == *" $d_target "* ]]; then
        _d_stage=$d_target
        _d_cf=$_d_cdir/$ddir/Containerfile
    elif [[ $d_target == *-* ]]; then
        _d_layer=${d_target##*-} _d_parent=${d_target%-*}
        _d_cf=$_d_cdir/$_d_layer/Containerfile
    else
        [ "$d_target" != devtools ] || _d_layer=devtools
        _d_parent=browser
        _d_cf=$_d_cdir/${d_dirs[$d_target]:-$d_target}/Containerfile
    fi
    if [ -n "$_d_parent" ]; then _d_base=localhost/$_d_image:$_d_parent${v:+-$v}
    else _d_base=${d_base:-${d_bases[$d_distro]}}; fi
}

# _d_aptcache_of DISTRO: that distro's apt cache directory (see d_aptcaches)
_d_aptcache_of() {
    if [ -n "${d_aptcaches[$1]:-}" ]; then echo "${d_aptcaches[$1]}"
    elif [ -n "${container:-}" ]; then echo "/var/cache/apt-$1"
    else echo "$d_dir/apt-cache-$1/archives"
    fi
}

# _d_need_target: d_target is a target of the selected distro: listed in its
# d_targets_<distro>, or <desktop>-<agent> with a listed desktop and an agent of
# d_agents. Either way its Containerfile must have the stage.
_d_need_target() {
    _d_distro || return
    local ok=
    if [[ " ${_d_targets[*]} " == *" $d_target "* ]]; then ok=1
    elif [ -n "$_d_layer" ] && [[ " ${d_agents[*]} " == *" $_d_layer "* ]] \
         && [[ " ${_d_targets[*]} " == *" $_d_parent "* ]] \
         && [[ " ${d_stages[*]} " != *" $_d_parent "* ]]; then ok=1
    fi
    if [ -z "$ok" ]; then
        echo "d_target '$d_target' isn't a $d_distro target (${_d_targets[*]}, or <desktop>-<agent>: ${d_agents[*]})" >&2
        return 1
    fi
    grep -Eq "^FROM [^ ]+ AS $_d_stage\s*$" "$_d_cf" 2>/dev/null && return
    echo "d_target '$d_target': ${_d_cf#"$_d_rcdir"/} has no stage $_d_stage" >&2
    return 1
}

export PODMAN_USERNS=keep-id
# or create ~/.config/containers/containers.conf with:
#[containers]
#userns = "keep-id"

d_0() {
    _d_distro || return
    local base=${d_base:-${d_bases[$d_distro]}}
    echo podman pull "$base"
    podman pull "$base"
}

# _d_desc [TARGET]: the target text of d_descs for TARGET (default d_target)
_d_desc() {
    local t=${1:-$d_target}
    if [[ $t == *-* ]]; then
        local a=${t##*-}
        echo "${d_descs[$d_distro:$a]:-${d_descs[$a]:-$a}}; $(_d_desc "${t%-*}")"
    else
        echo "${d_descs[$d_distro:$t]:-${d_descs[$t]:-$t stage}}"
    fi
}

# d_build [podman build options...]: extra args are passed to podman build (the context
# is this directory, so the Containerfiles COPY container/start.sh etc. and
# user_files/<distro>/). Builds the
# target it's built on first (with the same options, e.g. --no-cache): an agent desktop's
# desktop, a desktop's browser. Labels the image with
# org.opencontainers.image.description (see d_descs).
d_build() {
    _d_need_target || return
    if [ -n "$_d_parent" ]; then
        # shellcheck disable=SC2030  # intentional subshell scope for parent target build
        ( d_target=$_d_parent; unset d_description; d_build "$@" ) || return
        _d_need_target || return
    fi
    [ -d "$_d_aptcache" ] || { echo "d_build: no $d_distro apt cache at $_d_aptcache (create it; inside an instance, recreate that instance from the host with d_run)" >&2; return 1; }
    # --pull* only applies to the root distro stage (upstream base image); child layers
    # build FROM localhost/..., where --pull=newer would try to contact a local registry.
    local bargs=()
    if [ -n "$_d_parent" ]; then
        local skip=0 a
        for a in "$@"; do
            if [ "$skip" -eq 1 ]; then skip=0; continue; fi
            case $a in
                --pull) skip=1 ;;
                --pull=*) ;;
                *) bargs+=("$a") ;;
            esac
        done
    else
        bargs=("$@")
    fi
    local extra=()
    if [ "$_d_cf" = "$_d_cdir/deb/Containerfile" ]; then
        extra=(--build-arg DISTRO="$d_distro"
               --build-arg USER_FILES_GLOB="${d_distro%?}[${d_distro: -1}]")
    fi
    local desc=${d_description:-"${d_desc_distros[$d_distro]:-$d_distro}: $(_d_desc)"}
    local cmd=(build "${bargs[@]}" -t "$_d_image:$_d_tag" -f "$_d_cf" --target "$_d_stage"
               --build-arg BASE="$_d_base" "${extra[@]}"
               --label org.opencontainers.image.description="$desc"
               --build-arg USERID="$d_user" --build-arg USER_UID="$(id -u)"
               --build-arg USER_GID="$(id -g)"
               --security-opt label=disable
               -v "$_d_aptcache":/var/cache/apt-"$d_distro" "$_d_rcdir")
    echo podman "${cmd[@]}"
    # Through tee (stderr joins stdout) for the summary at the end: the time taken, and
    # for each apt step that ran, apt's "Need to get <downloaded>/<total>" ("0 B/…":
    # everything came from the shared cache; no "/": nothing did). pacman (archlinux)
    # prints "Total Download Size" only for a step that has to download something, and
    # "Total Installed Size" for every step that installs: <downloaded or 0>/<installed>.
    # dnf (fedora): "Total size of inbound packages is <total>. Need to download <downloaded>."
    # Run in a subshell so EXIT cleans up $log on Ctrl-C without touching the caller's traps.
    (
        blog=$(mktemp) || exit
        trap 'rm -f "$blog"' EXIT
        t0=$SECONDS
        podman "${cmd[@]}" 2>&1 | tee "$blog"
        rc=${PIPESTATUS[0]}
        t=$(( SECONDS - t0 ))
        apt=$(sed -n 's/^Need to get \(.*\) of archives\.$/\1/p' "$blog" | paste -sd, | sed 's/,/, /g')
        pac=$(awk '/^Total Download Size:/  { d = $4 " " $5 }
                   /^Total Installed Size:/ { printf "%s%s/%s %s", s, (d == "" ? "0" : d), $4, $5; s = ", "; d = "" }' "$blog")
        dnf=$(sed -n 's/^Total size of inbound packages is \(.*\)\. Need to download \(.*\)\.$/\2\/\1/p' "$blog" | paste -sd, | sed 's/,/, /g')
        if [ "$rc" -eq 0 ]; then echo "d_build: $_d_image:$_d_tag built in $(( t / 60 ))m$(( t % 60 ))s"
        else echo "d_build: $_d_image:$_d_tag FAILED (status $rc) after $(( t / 60 ))m$(( t % 60 ))s" >&2; fi
        if [ -n "$pac" ]; then echo "d_build: pacman downloaded/installed: $pac"
        elif [ -n "$dnf" ]; then echo "d_build: dnf downloaded/needed: $dnf"
        else echo "d_build: apt downloaded/needed: ${apt:-no apt, pacman or dnf step ran (layer cache)}"; fi
        exit "$rc"
    )
}

# d_build_fresh: pull a newer base if there is one and re-run every layer, so
# apt-get upgrade and the Chrome download aren't served from the layer cache
d_build_fresh() {
    d_build --pull=newer --no-cache "$@"
}

# VNC password: never passed in the environment, where it would stay visible in `podman
# inspect` and be inherited by everything in the desktop. While the home has no
# ~/.config/tigervnc/passwd, d_run writes $VNC_PASSWORD to passwd.init next to it (mode
# 600); start.sh turns that into passwd on first boot and deletes it. Nested, with no
# $VNC_PASSWORD, the new instance gets a copy of this instance's passwd.
_d_vnc_password() {
    local vncdir=$d_home/.config/tigervnc
    [ -s "$vncdir/passwd" ] && return
    if [ -n "${VNC_PASSWORD:-}" ]; then
        mkdir -p "$vncdir" && ( umask 077; printf '%s\n' "$VNC_PASSWORD" > "$vncdir/passwd.init" )
    elif [ -n "${container:-}" ] && [ -s ~/.config/tigervnc/passwd ]; then
        mkdir -p "$vncdir" && cp -p ~/.config/tigervnc/passwd "$vncdir/passwd"
    else
        echo "d_run: $vncdir/passwd doesn't exist and VNC_PASSWORD isn't set (see .env in the README)" >&2
        return 1
    fi
}

# Ports published on all interfaces, so only run on local LAN behind firewall
#
# /dev/fuse (fuse-overlayfs fallback) and /dev/net/tun (pasta) are for nested podman,
# which every stage has. unmask=/proc/* lets nested
# containers mount their own /proc (the kernel refuses while parts of it are masked);
# low risk rootless, as the unmasked files still belong to the host's real root.
# _d_run_args: fill the array _d_run_args with what d_run and d_run_cmd share (no name,
# ports or image): the home and apt cache mounts, devices, limits.
_d_run_args() {
    # Nested (inside an instance, $container set): utsns = "host", so no --hostname
    local hn=(--hostname "$d_name")
    [ -n "${container:-}" ] && hn=()
    # Every distro's apt cache that exists, for nested builds (see d_aptcaches)
    local apt=() d c
    for d in "${!d_images[@]}"; do
        c=$(_d_aptcache_of "$d")
        if [ -d "$c" ]; then apt+=(-v "$c":/var/cache/apt-"$d")
        else echo "d_run: no $d apt cache at $c; not mounted" >&2; fi
    done
    # --tz=local: the instance uses the host's timezone (a nested one gets its parent's).
    # D_NAME: the instance's own name, so a nested env.rc can name its children <name>_N.
    _d_run_args=(--init "${hn[@]}" --tz=local -e D_NAME="$d_name"
                 --shm-size=2g --tmpfs=/tmp --pids-limit "$d_pids_limit"
                 --security-opt label=disable --security-opt 'unmask=/proc/*'
                 --device /dev/fuse --device /dev/net/tun
                 -v "$d_home":/home/"$d_user"
                 "${apt[@]}")
}

d_run() {
    _d_need_instance || return
    _d_need_target || return
    mkdir -p "$d_home" || return
    # shellcheck disable=SC2031  # d_target is read here, not lost from subshell
    if [ "$d_target" != base ]; then _d_vnc_password || return; fi   # base: no VNC
    _d_run_args
    local bind=${d_bind:+${d_bind%:}:}
    local cmd=(run "${d_run_opts[@]}" --replace --name "$d_name" "${_d_run_args[@]}"
               -p "${bind}${h_ports[0]}:${d_ports[0]}"
               -p "${bind}${h_ports[1]}:${d_ports[1]}"
               "$_d_image:$_d_tag")
    echo podman "${cmd[@]}"
    podman "${cmd[@]}"
}

# d_run_cmd [CMD...]: run CMD (default: bash) interactively in a throwaway container
# <instance>-cmd (--rm) of the same image, on the selected instance's home, beside the
# instance if it is up (no --replace, no published ports). Not via start.sh: no
# first-boot seeding of a new home, no nested-subids (the image's build-time subids
# still suit a top-level instance), no VNC; run /usr/local/bin/start.sh in it for that.
# Like d_exec, CMD runs without ambient caps (--cap-add=NET_RAW would break bwrap/GTK).
d_run_cmd() {
    _d_need_instance || return
    _d_need_target || return
    mkdir -p "$d_home" || return
    [ $# -gt 0 ] || set -- bash
    local opts=() o
    for o in "${d_run_opts[@]}"; do
        case $o in -d|--detach) ;; *) opts+=("$o") ;; esac
    done
    _d_run_args
    local cmd=(run "${opts[@]}" --rm -it --name "$d_name-cmd" "${_d_run_args[@]}"
               "$_d_image:$_d_tag" setpriv --inh-caps=-all --ambient-caps=-all "$@")
    echo podman "${cmd[@]}"
    podman "${cmd[@]}"
}

d_vnc() {
    _d_need_instance || return
    command -v vncviewer >/dev/null || { echo "d_vnc: no vncviewer (TigerVNC) here; use d_novnc" >&2; return 1; }
    echo vncviewer :"${h_ports[0]}" -Shared=1 -passwd "$d_home/.config/tigervnc/passwd"
    vncviewer :"${h_ports[0]}" -Shared=1 -passwd "$d_home/.config/tigervnc/passwd"
}

# d_novnc: open the selected instance's noVNC page in the default browser (it asks for
# the VNC password). Without xdg-open, just print the URL. 127.0.0.1, not localhost:
# in instances from images before websockify listened on IPv6 too, the published port
# accepts a connection via localhost = ::1 and then resets it.
d_novnc() {
    _d_need_instance || return
    local url="http://127.0.0.1:${h_ports[1]}/vnc.html"
    echo "$url"
    command -v xdg-open >/dev/null || { echo "d_novnc: no xdg-open here; open the URL above in a browser" >&2; return 1; }
    xdg-open "$url"
}

d_logs() {
    _d_need_instance || return
    podman logs -f "$d_name"
}

# d_commit [IMAGE[:TAG]]: commit the selected container's writable layer (e.g. packages
# installed via `vnc-pkg`) back to an image. Default target: the instance's own image
# ($_d_image:$_d_tag), so a following `d_run` keeps the changes; pass an image or :tag to
# snapshot elsewhere. Uses --pause=false so it works without cgroups (nested podman) and
# without freezing the desktop. Clears $d_home/.config/vnc-desktop/commit-requested and
# writes commit-done so the container can see the commit completed.
d_commit() {
    _d_need_instance || return
    local target=${1:-$_d_image:$_d_tag}
    if [[ $target == :* ]]; then target=$_d_image$target; fi
    local req=$d_home/.config/vnc-desktop/commit-requested
    local note=
    [ -s "$req" ] && note=$(head -1 "$req")
    # OCI format (podman's default) rejects -m; --pause=false works without cgroups.
    local cmd=(commit --pause=false "$d_name" "$target")
    echo podman "${cmd[@]}"
    podman "${cmd[@]}" || return
    if [ -d "$d_home/.config/vnc-desktop" ]; then
        printf '%s %s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$target" "${note:+ ($note)}" \
            > "$d_home/.config/vnc-desktop/commit-done"
        rm -f "$req"
    fi
}

# d_commit_watch [IMAGE[:TAG]]: watch $d_home/.config/vnc-desktop/commit-requested
# (written by `vnc-pkg` inside the container) and automatically run `d_commit` whenever it
# appears. Uses `inotifywait` if installed (with a timeout fallback), otherwise polls
# every ${d_commit_poll:-2} s. Stop with Ctrl-C.
d_commit_watch() {
    _d_need_instance || return
    local dir=$d_home/.config/vnc-desktop
    local req=$dir/commit-requested
    mkdir -p "$dir" || return
    echo "d_commit_watch: watching $req (Ctrl-C to stop)"
    while true; do
        if [ -e "$req" ]; then
            d_commit "$@" || echo "d_commit_watch: d_commit failed" >&2
        fi
        if command -v inotifywait >/dev/null; then
            local rc=0
            inotifywait -qq -t "${d_commit_poll:-10}" -e close_write,moved_to,create "$dir" || rc=$?
            [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || return "$rc"
        else
            sleep "${d_commit_poll:-2}"
        fi
    done
}

# Shell snippet for inside an instance: p = PID of the session process, i.e. what
# xstartup became (vnc-session's last exec: xterm, gnome-panel, gnome-session, …): the
# child of the vncserver wrapper that isn't the X server. Fails if there's none. The
# wrapper is the shared bash one in /usr/local/bin (X server Xtigervnc or Xvnc).
# shellcheck disable=SC2016  # expanded inside the container by sh -c
_d_session_sh='p=; for c in $(pgrep -P "$(pgrep -o -f "^/bin/bash /usr/local/bin/vncserver ")" 2>/dev/null); do comm=$(cat "/proc/$c/comm" 2>/dev/null) || continue; case $comm in Xtigervnc|Xvnc) ;; *) p=$c ;; esac; done; [ -n "$p" ]'

# d_exec [-s] [-d|-i|-t|-it] [--] COMMAND...: podman exec in the selected instance, the way
# the desktop's own processes run: without the ambient capabilities that --cap-add gives
# every exec'ed process (bwrap, which GTK uses to load icons, refuses to run with them;
# see start.sh). -s: also with the session's environment (DBUS_SESSION_BUS_ADDRESS,
# DBUS_SYSTEM_BUS_ADDRESS, XDG_*, SHELL), for programs that need the session bus, e.g.
# `d_exec -s -d claude-desktop`. Other podman exec options (-u root, …): use podman exec.
d_exec() {
    _d_need_instance || return
    local opts=() session=
    while [[ ${1:-} == -* ]]; do
        case $1 in
            -s) session=1 ;;
            -d|-i|-t|-it|-ti) opts+=("$1") ;;
            --) shift; break ;;
            *) echo "d_exec: unknown option $1 (-s, -d, -i, -t)" >&2; return 1 ;;
        esac
        shift
    done
    [ $# -gt 0 ] || { echo "usage: d_exec [-s] [-d|-i|-t|-it] [--] COMMAND..." >&2; return 1; }
    local cmd=(exec "${opts[@]}" "$d_name" setpriv --inh-caps=-all --ambient-caps=-all)
    if [ -n "$session" ]; then
        # shellcheck disable=SC2016  # expanded inside the container by sh -c
        cmd+=(sh -c "$_d_session_sh"' || { echo "d_exec: no session process in this instance" >&2; exit 1; }
              IFS="
"; set -f
              exec env $(tr "\0" "\n" < /proc/$p/environ | grep -E "^(DBUS_SESSION_BUS_ADDRESS|DBUS_SYSTEM_BUS_ADDRESS|SHELL|XDG_[A-Z_]+)=") "$@"' sh)
    fi
    podman "${cmd[@]}" "$@"
}

# _d_wait_ready [SECONDS]: wait (default: up to 120 s) until the selected instance of
# stage $d_target is up: first boot has written the VNC password file, noVNC answers,
# and the display has a visible window (xdotool, in images since stage vnc got it).
# base: until podman exec works. The desktop may still be drawing: allow a few seconds.
_d_wait_ready() {
    local end=$(( SECONDS + ${1:-120} ))
    while [ "$SECONDS" -lt "$end" ]; do
        # shellcheck disable=SC2031
        if [ "$d_target" = base ]; then
            podman exec "$d_name" true 2>/dev/null && return
        elif [ -s "$d_home/.config/tigervnc/passwd" ] \
             && curl -sf -o /dev/null "http://127.0.0.1:${h_ports[1]}/vnc.html" \
             && podman exec "$d_name" xdotool search --onlyvisible --name . >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

# _d_rm: remove the container $d_name and delete its home $d_home, without asking.
# podman rm sometimes fails once with an openByHandleAt error about exec sessions, so
# it's tried again. The home may hold files owned by sub-IDs (nested podman storage),
# which only `podman unshare rm` can delete.
_d_rm() {
    for _ in 1 2 3; do
        podman container exists "$d_name" || break
        podman rm -f -t 2 "$d_name" >/dev/null 2>&1
    done
    if podman container exists "$d_name"; then
        echo "d_rm: couldn't remove container $d_name; its home $d_home is left alone" >&2; return 1
    fi
    [ -n "$d_home" ] && [ -e "$d_home" ] || return 0
    podman unshare rm -rf "$d_home"
}

# d_rm [-f] [N]: remove instance N (default: the selected one) of $d_distro: its
# container AND ITS HOME DIRECTORY, with everything in it. Asks first; -f doesn't.
# The selection isn't changed.
d_rm() {
    local force=
    [ "${1:-}" = -f ] && { force=1; shift; }
    if [ $# -gt 0 ]; then
        [[ $1 =~ ^[1-9][0-9]*$ ]] && [ "$1" -le 49 ] || { echo "usage: d_rm [-f] [N]  (1 <= N <= 49)" >&2; return 1; }
        _d_names "$1" || return
    else
        _d_need_instance || return
    fi
    if ! podman container exists "$d_name" && [ ! -e "$d_home" ]; then
        echo "d_rm: no container $d_name and no $d_home"; return 0
    fi
    if [ -z "$force" ]; then
        local a
        read -r -p "Remove container $d_name and delete $d_home with everything in it? [y/N] " a || return 1
        [[ $a == [yY] ]] || { echo "d_rm: nothing removed"; return 1; }
    fi
    _d_rm && echo "removed $d_name and $d_home"
}

# d_all N [STAGE...]: for each stage of $d_distro (default: all, in Containerfile order) d_build it,
# then d_select N, N+1, … and d_run it there, and run $d_all_cmd (default d_vnc, a
# viewer) in the background once the instance's desktop is up (not for
# base: no VNC). The command is eval'ed in a subshell with that instance selected and
# d_target set to its stage, so it can use d_* functions and $d_name, $d_home,
# ${h_ports[@]}. N is required because d_run replaces an existing instance with that
# number. Leaves the last instance selected but d_target at its env.rc value, so pass
# d_target=<stage> to a later d_run for it. The command's output goes to
# /tmp/d_all-<name>.log. Stops at the first failed build or run.
d_all() {
    _d_distro || return
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || { echo "usage: d_all N [STAGE...]  (instances N, N+1, …; default stages: ${_d_targets[*]})" >&2; return 1; }
    local n=$1; shift
    local stages=("$@"); [ ${#stages[@]} -gt 0 ] || stages=("${_d_targets[@]}")
    local d_target
    for d_target in "${stages[@]}"; do
        echo "=== $d_target"
        d_build || { echo "d_all: d_build $d_target failed" >&2; return 1; }
        d_select "$n" || return
        d_run || { echo "d_all: d_run $d_target failed" >&2; return 1; }
        if [ "$d_target" != base ] && [ -n "${d_all_cmd:-}" ]; then
            # Background subshell: keeps this instance's selection; waits up to 60 s
            # for the desktop to come up (and runs the command anyway after that).
            ( _d_wait_ready 60; eval "$d_all_cmd" ) > "/tmp/d_all-$d_name.log" 2>&1 &
        fi
        n=$((n + 1))
    done
}

# d_screenshots N [STAGE...]: retake docs/$d_distro/<stage>.png, the picture of each stage's
# desktop as it first comes up (default stages: vnc and the distro's plain desktops —
# excluding base, browser, devtools and agent desktops; pass explicit names to include
# those). For each stage: d_build, d_run it on instance N with a new home, wait for the
# desktop to come up and settle ($d_shot_wait seconds more, default 30), run
# tests/screenshot.sh in it, then remove the container and that home again. N must be
# unused (no container, no home dir, free port), so nothing of yours is replaced or
# deleted. A stage without a screenshot tool (vnc) gets scrot installed in the throwaway
# container (with apt, dnf, or pacman where the image has that).
# Runs in a subshell: your instance selection and d_target are left alone.
d_screenshots() (
    _d_distro || return
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || { echo "usage: d_screenshots N [STAGE...]  (N: an unused instance number)" >&2; return 1; }
    n=$1; shift
    stages=("$@")
    if [ ${#stages[@]} -eq 0 ]; then
        for t in "${_d_targets[@]}"; do
            case $t in base|browser|devtools|*-*) ;; *) stages+=("$t") ;; esac
        done
    fi
    docs=$_d_rcdir/docs/$d_distro
    mkdir -p "$docs" || return
    shot() { d_exec bash "/home/$d_user/.d_screenshot.sh" "/home/$d_user/.d_screenshot.png" >/dev/null; }
    rc=0
    # shellcheck disable=SC2030  # intentional subshell scope
    for d_target in "${stages[@]}"; do
        d_select "$n" >/dev/null || return
        if podman container exists "$d_name" || [ -e "$d_home" ] || _d_port_used "${h_ports[0]}"; then
            echo "d_screenshots: instance $n is in use ($d_name, $d_home, or port ${h_ports[0]} in use); pick an unused number" >&2
            return 1
        fi
        echo "=== $d_target"
        if ! d_build >/dev/null; then
            echo "d_screenshots: building $d_target failed" >&2; rc=1
            continue
        fi
        if d_run >/dev/null; then
            _d_wait_ready
            sleep "${d_shot_wait:-30}"
            cp "$_d_rcdir/tests/screenshot.sh" "$d_home/.d_screenshot.sh"
            shot; s=$?
            if [ "$s" -eq 2 ]; then
                echo "no screenshot tool in $d_target: installing scrot in $d_name"
                podman exec -u root "$d_name" sh -c 'if command -v pacman >/dev/null; then pacman -Syu --noconfirm --needed scrot
                    elif command -v dnf >/dev/null; then dnf -y -q install scrot
                    else apt-get update -qq && apt-get install -y -qq --no-install-recommends scrot; fi' >/dev/null
                shot; s=$?
            fi
            if [ "$s" -eq 0 ] && cp "$d_home/.d_screenshot.png" "$docs/$d_target.png"; then
                echo "$docs/$d_target.png"
            else
                echo "d_screenshots: no screenshot of $d_target" >&2; rc=1
            fi
            _d_rm
        else
            echo "d_screenshots: running $d_target failed" >&2; rc=1
            _d_rm
        fi
    done
    return $rc
)

# d_test N [STAGE...]: build each stage of $d_distro (default: all), run it on a
# throwaway instance N with a new home, and check it; prints ok/FAIL per check and
# returns non-zero if any failed. N must be unused (no container, no home dir), so
# nothing of yours is replaced or deleted; afterwards the instance and its home are
# removed again, unless d_test_keep=1 (then the stages go on N, N+1, …). The checks:
# the build; the instance comes up; tests/tests.sh in it (nested podman); no
# VNC_PASSWORD in `podman inspect` or in any process's environment; no sudo; the apt
# cache mounts; and, with a display (not base): noVNC answers on 127.0.0.1 and [::1],
# Chrome renders a page (headless; from stage browser on; archlinux: Chromium),
# a screenshot (tests/screenshot.sh, where the stage has a tool for it), the screen
# can't be locked (tests/lock.sh), ending the session stops the container, and
# `podman start` brings it back. Build logs, the checks' output and the screenshots go
# to $d_test_dir (default /tmp/d_test) as <instance>-<stage>.*.
# Runs in a subshell: your instance selection and d_target are left alone.
d_test() (
    _d_distro || return
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || { echo "usage: d_test N [STAGE...]  (N: an unused instance number; default stages: ${_d_targets[*]})" >&2; return 1; }
    n=$1; shift
    stages=("$@"); [ ${#stages[@]} -gt 0 ] || stages=("${_d_targets[@]}")
    out=${d_test_dir:-/tmp/d_test}
    mkdir -p "$out" || return
    fails=0
    # check NAME COMMAND...: the command's output goes to the stage's log
    check() {
        local name=$1; shift
        if "$@" >> "$log.log" 2>&1; then echo "ok   $name"; else echo "FAIL $name"; fails=$((fails + 1)); fi
    }
    # shellcheck disable=SC2329  # invoked indirectly via check
    in_c() { podman exec "$d_name" "$@"; }
    # shellcheck disable=SC2329
    novnc() { curl -sSf -o /dev/null "http://$1:${h_ports[1]}/vnc.html"; }
    # End the session as logging out does (the session process exits), then: the
    # container has stopped, and start.sh's log says why.
    # shellcheck disable=SC2329
    session_end() {
        # shellcheck disable=SC2016
        in_c sh -c "$_d_session_sh"' && kill "$p"' || return
        for _ in $(seq 30); do
            [ "$(podman inspect -f '{{.State.Status}}' "$d_name")" = exited ] && break
            sleep 1
        done
        podman inspect -f '{{.State.Status}}' "$d_name"
        [ "$(podman inspect -f '{{.State.Status}}' "$d_name")" = exited ] \
            && podman logs "$d_name" 2>&1 | grep 'vncserver exited'
    }
    # shellcheck disable=SC2329
    restart() { podman start "$d_name" && _d_wait_ready; }
    # a data: URL, so it needs no network; its own profile directory. The browser is
    # google-chrome, or chromium where the image has that instead (archlinux).
    # shellcheck disable=SC2329
    chrome_ok() {
        # shellcheck disable=SC2016
        d_exec sh -c 'b=$(command -v google-chrome || command -v chromium) || exit
            exec "$b" --headless --user-data-dir=/tmp/d_test-chrome \
                --dump-dom "data:text/html,<p>d_test-chrome-ok</p>"' | grep d_test-chrome-ok
    }
    # The target has Chrome or Chromium: browser and everything built on it
    # shellcheck disable=SC2031
    has_chrome() { case $d_target in base|vnc) return 1 ;; esac; }
    for d_target in "${stages[@]}"; do
        d_select "$n" >/dev/null || return
        echo "=== $d_distro $d_target ($d_name)"
        if podman container exists "$d_name" || [ -e "$d_home" ] || _d_port_used "${h_ports[0]}"; then
            echo "d_test: instance $n is in use ($d_name, $d_home, or port ${h_ports[0]} in use); pick an unused number" >&2
            return 1
        fi
        log=$out/$d_name-$d_target
        rm -f "$log".*
        if d_build > "$log.build.log" 2>&1; then
            echo "ok   build"
        else
            echo "FAIL build (see $log.build.log)"; fails=$((fails + 1)); continue
        fi
        grep '^d_build: ' "$log.build.log"
        if d_run >> "$log.log" 2>&1; then
            check "instance comes up" _d_wait_ready
            ready=$SECONDS
            cp -r "$_d_rcdir/tests" "$d_home/.d_tests"
            check "nested podman (tests/tests.sh)" in_c "/home/$d_user/.d_tests/tests.sh"
            # shellcheck disable=SC2016
            check "no VNC_PASSWORD in podman inspect" eval '! podman inspect "$d_name" | grep -q VNC_PASSWORD'
            check "no VNC_PASSWORD in a process environment" \
                in_c sh -c 'cat /proc/[0-9]*/environ 2>/dev/null | tr "\0" "\n" | { ! grep -q "^VNC_PASSWORD="; }'
            check "sudo refused" in_c sh -c '! sudo -n true'
            for d in "${!d_images[@]}"; do
                [ -d "$(_d_aptcache_of "$d")" ] && check "apt cache mounted at /var/cache/apt-$d" in_c mountpoint /var/cache/apt-"$d"
            done
            if [ "$d_target" != base ]; then
                check "noVNC on 127.0.0.1:${h_ports[1]}" novnc 127.0.0.1
                check "noVNC on [::1]:${h_ports[1]}" novnc '[::1]'
                ! has_chrome || check "Chrome renders a page (headless)" chrome_ok
                # let the desktop settle: d_shot_wait seconds (default 30) since it came up
                s=$(( ready + ${d_shot_wait:-30} - SECONDS )); [ "$s" -le 0 ] || sleep "$s"
                d_exec bash "/home/$d_user/.d_tests/screenshot.sh" "/home/$d_user/.d_tests/shot.png" >> "$log.log" 2>&1; s=$?
                # shellcheck disable=SC2016
                if [ "$s" -eq 2 ]; then echo "skip screenshot (no tool in this stage)"
                else check "screenshot: $log.png" eval '[ "$s" -eq 0 ] && cp "$d_home/.d_tests/shot.png" "$log.png"'; fi
                check "screen can't be locked (tests/lock.sh)" d_exec -s bash "/home/$d_user/.d_tests/lock.sh"
                check "ending the session stops the container" session_end
                check "podman start brings it back" restart
            fi
        else
            echo "FAIL run (see $log.log)"; fails=$((fails + 1))
        fi
        if [ -n "${d_test_keep:-}" ]; then
            echo "kept: $d_name, home $d_home (remove with: d_distro=$d_distro d_target=$d_target d_rm $n)"
            n=$((n + 1))
        else
            _d_rm
        fi
    done
    echo "$fails failed; logs in $out"
    [ "$fails" -eq 0 ]
)

# Chrome automation helpers (d_chrome, d_chrome_mcp): see chrome/README.md
source "$_d_rcdir/chrome/env.rc"
