ARG BASE=docker.io/library/debian:trixie

# Debian 13 (trixie). Same layering as ../ubuntu/Containerfile, whose base, vnc and chrome
# stages this follows (keep them in step); only Debian's default desktop, GNOME. Build
# with d_distro=debian; the context is the repo root (the shared start.sh, nested-subids).
# Stages, each runnable with d_run (d_target in env.rc picks one; the image is tagged
# d13cc:<stage>):
#   base   - Debian + network/debug tools + nested rootless podman; headless
#   vnc    - base + TigerVNC/noVNC, session is a bare xterm
#   chrome - vnc + Google Chrome (via the --no-sandbox wrapper)
#   gnome  - chrome + GNOME desktop
# Each stage with a display installs /usr/local/bin/vnc-session, which the home's
# ~/.config/tigervnc/xstartup runs, so the session follows the image, not the home.

# ---------------------------------------------------------------------------------------
# Stage "base": minimal image with nested rootless podman, network and debug tools
FROM ${BASE} AS base

# The container user. d_build passes d_user and the builder's UID, so that with
# PODMAN_USERNS=keep-id it is the host user and owns the home volume.
ARG USERID=ed
ARG USER_UID=1001

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    USERID=${USERID}

# Keep downloaded .debs: apt keeps them in /var/cache/apt-debian (Dir::Cache::archives),
# where d_build mounts the shared (NFS) debian apt cache; d_run mounts both distros'
# caches (/var/cache/apt-ubuntu, /var/cache/apt-debian), so a build nested in an
# instance uses the right one whichever distro it is. The image's docker-clean deletes .debs
# after every install, so drop it, but keep its other job: no
# pkgcache.bin/srcpkgcache.bin (~50 MB each, rebuilt from the lists anyway). Each apt
# RUN ends with `mountpoint -q /var/cache/apt-debian || apt-get clean`, so a plain
# `podman build` without the mount doesn't leave .debs in the image layers either.
RUN rm /etc/apt/apt.conf.d/docker-clean \
    && printf 'Dir::Cache::pkgcache "";\nDir::Cache::srcpkgcache "";\n' \
        > /etc/apt/apt.conf.d/docker-no-pkgcache \
    && printf 'Dir::Cache::archives "/var/cache/apt-debian/";\n' > /etc/apt/apt.conf.d/vnc-desktop-archives

# Basics, network/debug and development tools, and nested rootless podman. The user
# has no root in the container (below), so what's needed at runtime has to be here.
# keep list sorted
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    bc \
    bind9-dnsutils \
    build-essential \
    bzip2 \
    ca-certificates \
    catatonit \
    curl \
    emacs-nox \
    file \
    fuse-overlayfs \
    gh \
    git \
    gnupg \
    iperf3 \
    iproute2 \
    iputils-ping \
    jq \
    less \
    libcap2-bin \
    lsof \
    nano \
    netcat-openbsd \
    nodejs \
    npm \
    openssh-client \
    passt \
    patch \
    podman \
    procps \
    python3-pip \
    python3-venv \
    ripgrep \
    rsync \
    shellcheck \
    strace \
    sudo \
    tmux \
    tree \
    uidmap \
    unzip \
    wget \
    xz-utils \
    zip \
    && { mountpoint -q /var/cache/apt-debian || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# Non-root user with a fixed UID; a user the base image ships with that UID makes way
# (Debian's has none; kept in step with Ubuntu's). No general root: the only thing it
# may sudo is the boot-time nested-subids (root-owned, and "" = without arguments),
# which start.sh runs. Add packages here and rebuild, or use `podman exec -u root` from outside.
RUN old=$(getent passwd "${USER_UID}" | cut -d: -f1) \
    && { [ -z "$old" ] || userdel -r "$old"; } \
    && useradd -m -s /bin/bash -u "${USER_UID}" ${USERID} \
    && echo "${USERID} ALL=(root) NOPASSWD: /usr/local/sbin/nested-subids \"\"" > /etc/sudoers.d/${USERID} \
    && chmod 440 /etc/sudoers.d/${USERID} \
    && visudo -cf /etc/sudoers.d/${USERID}

# Subordinate IDs must fit inside the 65536 UIDs the outer (rootless) container has;
# useradd's default ed:165536:65536 is outside it. Use 1 to UID-1 and UID+1 to 65535
# (skip the user's own; for ed, 1001: 1-1000 and 1002-65535): inner containers get root->ed plus 65534 subids. subgid also gets
# group 0 (ed:0:1), so root in a nested build can use the shared apt cache (see
# nested-subids). These are defaults: at every boot start.sh runs nested-subids, which
# rewrites them from the container's actual ID map (needed one level deeper, e.g.
# ccN_M) and re-applies the file caps below.
RUN printf '%s:1:%d\n%s:%d:%d\n' ${USERID} $((USER_UID - 1)) ${USERID} $((USER_UID + 1)) $((65535 - USER_UID)) > /etc/subuid \
    && { cat /etc/subuid; printf '%s:0:1\n' ${USERID}; } > /etc/subgid

# setuid-root newuidmap runs with euid 0, which is not the owner of the new user
# namespace, so writing uid_map needs CAP_SYS_ADMIN, which the outer container lacks
# (EPERM). With file caps instead, euid stays ed (the owner); it only adds SETUID/SETGID.
RUN chmod u-s /usr/bin/newuidmap /usr/bin/newgidmap \
    && setcap cap_setuid=ep /usr/bin/newuidmap \
    && setcap cap_setgid=ep /usr/bin/newgidmap

# ping: Debian's has no file caps (unlike Ubuntu's, cap_net_raw=ep): it relies on
# net.ipv4.ping_group_range for unprivileged ICMP sockets, which systemd opens up but is
# "0 0" in the container. With the cap it works like Ubuntu's: when the instance has
# NET_RAW (d_run_opts --cap-add=NET_RAW) in its bounding set.
RUN setcap cap_net_raw=ep /usr/bin/ping

# No systemd/logind in the container: no cgroup delegation, no journald.
# utsns = "host": the outer seccomp profile blocks sethostname without CAP_SYS_ADMIN,
# so nested containers share the instance's hostname instead of setting their own.
RUN mkdir -p /etc/containers/containers.conf.d && printf '%s\n' \
        '[containers]' \
        'cgroups = "disabled"' \
        'utsns = "host"' \
        '' \
        '[engine]' \
        'cgroup_manager = "cgroupfs"' \
        'events_logger = "file"' \
        > /etc/containers/containers.conf.d/nested.conf

COPY --chmod=755 nested-subids /usr/local/sbin/nested-subids

# Claude Code: run install_claude as the user at runtime. The native installer puts it in
# ~/.local/bin (home volume), so it persists and self-updates.
RUN printf '#!/bin/bash\nset -ex\ncurl -fsSL https://claude.ai/install.sh | bash\n' \
    > /usr/local/bin/install_claude \
    && chmod +x /usr/local/bin/install_claude

# start.sh: first-boot home setup and nested-subids; then the VNC session if the stage
# has one, otherwise it just waits (use `podman exec -it <name> bash`).
COPY --chmod=755 start.sh /usr/local/bin/start.sh

# Files for the home: debian/user_files/ (gitignored, may be absent) is packed into
# /usr/local/share/user_files.tar, which start.sh unpacks into a new home on its first
# boot, over /etc/skel's copies. Changing them rebuilds every later stage. LICENSE
# is only there because COPY fails when no source exists (a top-level user_files/LICENSE
# would be dropped). The files are in the image: no secrets, if the image is shared.
COPY LICENSE debian/user_file[s] /tmp/user_files/
RUN rm /tmp/user_files/LICENSE \
    && if [ -n "$(ls -A /tmp/user_files)" ]; then \
           find /tmp/user_files -mindepth 1 -maxdepth 1 -printf '%P\0' \
           | tar -C /tmp/user_files --null -T - --owner=0 --group=0 -cf /usr/local/share/user_files.tar; \
       fi \
    && rm -rf /tmp/user_files

USER ${USERID}
WORKDIR /home/${USERID}
CMD ["/usr/local/bin/start.sh"]

# ---------------------------------------------------------------------------------------
# Stage "vnc": TigerVNC server/viewer and noVNC, no desktop: the session is an xterm
FROM base AS vnc
USER root

ENV DISPLAY=:1 \
    VNC_RESOLUTION=1440x900

# dbus-x11: xstartup runs the session under dbus-launch (desktops and Chrome use the bus)
# keep list sorted
RUN apt-get update && apt-get install -y --no-install-recommends \
    dbus-x11 \
    novnc \
    tigervnc-standalone-server \
    tigervnc-tools \
    tigervnc-viewer \
    websockify \
    xterm \
    && { mountpoint -q /var/cache/apt-debian || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# The session: closing it (exit the xterm, or log out of a desktop) stops the container.
RUN printf '#!/bin/sh\nexec xterm\n' > /usr/local/bin/vnc-session \
    && chmod +x /usr/local/bin/vnc-session

USER ${USERID}
EXPOSE 5901 6080

# ---------------------------------------------------------------------------------------
# Stage "chrome": vnc + Google Chrome
FROM vnc AS chrome
USER root

# Fonts for web pages: metric-compatible Latin, CJK (else Chinese/Japanese/Korean text
# shows as empty boxes), emoji
# keep list sorted
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-liberation \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && { mountpoint -q /var/cache/apt-debian || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# Google Chrome (amd64 only). The .deb's postinst adds Google's apt repo + key itself.
RUN curl -fsSLo /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update && apt-get install -y /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb \
    && { mountpoint -q /var/cache/apt-debian || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# Chrome needs these flags in a container (no user-namespace sandbox).
# Wrapper in /usr/local/bin shadows /usr/bin on PATH; menu entries are pointed at it too
# (the build fails if a new Chrome's .desktop files no longer have the expected Exec=),
# and it outranks Chrome's own alternatives (priority 200), because XFCE's default
# WebBrowser (exo-open --launch WebBrowser) is sensible-browser -> x-www-browser.
RUN printf '#!/bin/sh\nexec /usr/bin/google-chrome-stable --no-sandbox --no-first-run --no-default-browser-check "$@"\n' \
        > /usr/local/bin/google-chrome-stable \
    && chmod +x /usr/local/bin/google-chrome-stable \
    && ln -s google-chrome-stable /usr/local/bin/google-chrome \
    && for alt in gnome-www-browser google-chrome x-www-browser; do \
           update-alternatives --install /usr/bin/$alt $alt /usr/local/bin/google-chrome-stable 300; \
       done \
    && for f in google-chrome com.google.Chrome; do \
           sed -i 's|^Exec=/usr/bin/google-chrome-stable|Exec=/usr/local/bin/google-chrome-stable|' \
               /usr/share/applications/$f.desktop \
           && grep -q '^Exec=/usr/local/bin/google-chrome-stable' /usr/share/applications/$f.desktop \
           || { echo "$f.desktop: Exec= not pointed at the wrapper" >&2; exit 1; }; \
       done

USER ${USERID}

# ---------------------------------------------------------------------------------------
# Stage "gnome": chrome + GNOME (GNOME Shell's X11 session), Debian's default desktop
FROM chrome AS gnome
USER root

# GNOME 48 still has an X11 session (Ubuntu 26.04's GNOME 50 doesn't; that stage is
# Flashback). Without the recommends: no Firefox, Evolution, Software etc.
# gnome-screenshot: tests/screenshot.sh
# keep list sorted
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnome-screenshot \
    gnome-session \
    gnome-shell \
    gnome-terminal \
    nautilus \
    && { mountpoint -q /var/cache/apt-debian || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# No systemd: gnome-session falls back to starting the session itself, but aborts without
# a system bus, and there's no system dbus-daemon (it'd need root). So the session runs
# its own stand-in, with no services on it (no logind, polkit, …: GNOME warns and goes
# on), at $XDG_RUNTIME_DIR, which nothing else sets either.
# --disable-acceleration-check: the check rejects software rendering (llvmpipe), which
# is what the VNC X server has; GNOME Shell runs on it fine.
# No screen locking: without GDM, GNOME Shell has no screen shield, so lock requests
# (Super+L, org.gnome.ScreenSaver.Lock) find nothing to lock; the settings below turn
# locking and idle blanking off as well.
RUN printf '%s\n' '<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"' \
        ' "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">' \
        '<busconfig>' \
        '  <type>system</type>' \
        '  <auth>EXTERNAL</auth>' \
        '  <listen>unix:tmpdir=/tmp</listen>' \
        '  <policy context="default">' \
        '    <allow send_destination="*" eavesdrop="true"/>' \
        '    <allow eavesdrop="true"/>' \
        '    <allow own="*"/>' \
        '  </policy>' \
        '</busconfig>' \
        > /usr/local/share/vnc-system-bus.conf \
    && printf '%s\n' '#!/bin/sh' \
        'export XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)" XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=GNOME' \
        'mkdir -p -m 700 "$XDG_RUNTIME_DIR"' \
        'export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/system_bus_socket"' \
        'dbus-daemon --fork --config-file=/usr/local/share/vnc-system-bus.conf --address="$DBUS_SYSTEM_BUS_ADDRESS"' \
        'exec gnome-session --disable-acceleration-check' \
        > /usr/local/bin/vnc-session

# Dash favourites: Debian's are mostly apps that aren't installed (Firefox, Evolution,
# Software, …), which leaves only Files. always-show-log-out: GNOME hides Log Out (the
# way to end the session and stop the container) when there's only one local user.
RUN printf '%s\n' \
        '[org.gnome.desktop.lockdown]' 'disable-lock-screen=true' \
        '[org.gnome.desktop.screensaver]' 'lock-enabled=false' \
        '[org.gnome.desktop.session]' 'idle-delay=uint32 0' \
        '[org.gnome.shell]' 'always-show-log-out=true' \
        "favorite-apps=['google-chrome.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']" \
        > /usr/share/glib-2.0/schemas/99_vnc-desktop.gschema.override \
    && glib-compile-schemas --strict /usr/share/glib-2.0/schemas

USER ${USERID}
