ARG BASE=localhost/u2604cc:lxqt

# T3 Code (d_distro=t3code, https://t3.codes): Ubuntu's lxqt stage
# (../ubuntu/Containerfile: LXQt, Google Chrome, TigerVNC/noVNC, nested podman) plus
# install_t3code for the t3 CLI (a web GUI for coding agents such as Claude Code). The
# base is that locally built image, so d_build builds it first. The build context is the
# repo root. One stage, tagged u2604t3code:lxqt:
#   lxqt - lxqt + install_t3code (T3 Code CLI); session is LXQt
# See README.md here.

# ---------------------------------------------------------------------------------------
# Stage "lxqt": Ubuntu's lxqt + T3 Code
FROM ${BASE} AS lxqt
USER root

# d_build passes these to every Containerfile. The user itself comes with the base image
# (as does ENV USERID), so they're unused here.
ARG USERID
ARG USER_UID

# fd-find, fzf: finding and picking files, for the agent's shell and yours
# featherpad: a GUI text editor (LXQt's), to look at and edit what the agent wrote
# keep list sorted
RUN apt-get update && apt-get install -y --no-install-recommends \
    fd-find \
    featherpad \
    fzf \
    && { mountpoint -q /var/cache/apt-ubuntu || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# T3 Code CLI (t3): run install_t3code as the user at runtime, like install_claude.
# T3's installer (sh, tar, sha256sum, curl: all in the base) unpacks a self-contained
# release (~500 MB, no Node needed) into ~/.t3/runtime/versions/<version> and writes a
# launcher ~/.local/bin/t3, both on the home volume; `t3 update` updates it. The latest
# stable release, or T3CODE_VERSION / T3CODE_CHANNEL (stable|nightly) from the env.
# The installer only prints a hint when ~/.local/bin isn't on PATH, and a fresh home's
# .bashrc (from /etc/skel) doesn't add it: install_t3code appends a guarded block to
# ~/.bashrc when the file doesn't mention .local/bin.
COPY --chmod=755 <<'EOF' /usr/local/bin/install_t3code
#!/bin/bash
set -ex
curl -fsSL https://t3.codes/install.sh | sh
if ! grep -qs '\.local/bin' "$HOME/.bashrc"; then
    cat >> "$HOME/.bashrc" <<'EOB'

# ~/.local/bin on PATH (added by install_t3code, for t3)
if [ -d "$HOME/.local/bin" ] && [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin${PATH:+:${PATH}}"
fi
EOB
fi
EOF

USER ${USERID}
