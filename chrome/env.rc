# -*- sh -*-

# Chrome automation helpers, sourced by ../env.rc (which they need: d_exec,
# _d_need_instance, d_user). See README.md here for the options and what's been tried.

# d_chrome [URL...]: Chrome on the selected instance's desktop with the DevTools
# (remote debugging) port open, for automation: http://127.0.0.1:$d_chrome_port
# (default 9222), which listens inside the instance only, so clients run there
# (d_exec, d_chrome_mcp). Its profile is ~/.config/chrome-automation, not Chrome's
# usual one: Chrome ignores --remote-debugging-port on the default profile. If it's
# already running, the URLs open in it; started without a URL, it shows chrome://version/. d_chrome_bin picks another browser, e.g.
# d_chrome_bin=google-chrome-canary (image u2604chrome:canary), with its own profile
# ~/.config/<browser>-automation; give it another d_chrome_port to run both at once.
d_chrome() {
    _d_need_instance || return
    local port=${d_chrome_port:-9222} bin=${d_chrome_bin:-google-chrome} i
    local profile=chrome-automation
    [ "$bin" = google-chrome ] || profile=$bin-automation
    local chrome=("$bin" --remote-debugging-port="$port" --user-data-dir="/home/$d_user/.config/$profile")
    local up=(podman exec "$d_name" curl -sf -o /dev/null "http://127.0.0.1:$port/json/version")
    local fresh=
    if ! "${up[@]}"; then
        fresh=1
        d_exec -s -d "${chrome[@]}" "$@" >/dev/null || return
    elif [ $# -gt 0 ]; then
        d_exec -s -d "${chrome[@]}" "$@" >/dev/null || return
    fi
    for i in $(seq 30); do
        if "${up[@]}"; then
            # Started with nothing to open: show which browser this is (version, command
            # line, profile path) in place of the New Tab page. Chrome turns a chrome://
            # URL on its command line into a New Tab, so it's opened through the port.
            if [ -n "$fresh" ] && [ $# -eq 0 ]; then
                podman exec "$d_name" sh -c '
                    u=http://127.0.0.1:$1/json
                    old=$(curl -s $u/list | jq -r ".[] | select(.type == \"page\" and (.url | test(\"^chrome://new-?tab\"))) | .id")
                    curl -s -o /dev/null -X PUT "$u/new?chrome://version/" || exit
                    for id in $old; do curl -s -o /dev/null "$u/close/$id"; done' sh "$port" \
                    || echo "d_chrome: couldn't open chrome://version/" >&2
            fi
            echo "$bin in $d_name: DevTools port http://127.0.0.1:$port (inside the instance)"
            return 0
        fi
        sleep 1
    done
    echo "d_chrome: $bin's DevTools port $port in $d_name doesn't answer" >&2
    return 1
}

# _d_devtools_opts: chrome-devtools-mcp's options for the selected instance, in
# _d_dt_opts: attach to d_chrome's browser; no usage statistics to Google and no page
# URLs to its CrUX API (--performanceCrux adds field data to performance traces: put it
# in d_devtools_opts to have it); files it reads and writes (screenshots, traces) may be
# anywhere in the home, which is $d_home out here. d_devtools_opts=(...) adds options,
# e.g. (--categoryNetwork=false); see `chrome-devtools-mcp --help`.
_d_devtools_opts() {
    _d_dt_opts=(--browserUrl "http://127.0.0.1:${d_chrome_port:-9222}" --no-usage-statistics
                --performanceCrux=false --workspace="/home/$d_user" "${d_devtools_opts[@]}")
}

# d_chrome_mcp: print the command that registers the selected instance's Chrome (as
# started by d_chrome) with Claude Code as MCP server chrome-<instance>:
# chrome-devtools-mcp runs inside the instance, next to Chrome, and Claude Code talks
# to it over podman exec's stdin/stdout, so no port leaves the instance. Where the image
# has chrome-devtools-mcp (u2604chrome:canary) that one is used; otherwise npx downloads
# the latest into the instance's home at each start. Options: _d_devtools_opts above.
# Only printed: it changes your Claude Code configuration, so run it yourself.
d_chrome_mcp() {
    _d_need_instance || return
    local mcp="npx -y chrome-devtools-mcp@latest" _d_dt_opts
    podman exec "$d_name" sh -c 'command -v chrome-devtools-mcp' >/dev/null 2>&1 && mcp=chrome-devtools-mcp
    _d_devtools_opts
    echo "claude mcp add chrome-$d_name -- podman exec -i $d_name setpriv --inh-caps=-all --ambient-caps=-all" \
         "$mcp ${_d_dt_opts[*]}"
}

# d_devtools COMMAND [ARGS...]: Chrome DevTools from the shell, on d_chrome's browser in
# the selected instance: the chrome-devtools CLI that comes with chrome-devtools-mcp
# (image u2604chrome:canary). Commands are the MCP server's tools, e.g.
#   d_devtools list_pages
#   d_devtools navigate_page 1 --url https://example.com
#   d_devtools take_screenshot 1 --fullPage --filePath shot.png    # -> $d_home/shot.png
#   d_devtools --help;  d_devtools take_snapshot --help
# The CLI talks to a daemon in the instance, which this starts when needed (with
# _d_devtools_opts) and restarts when d_chrome_port or d_devtools_opts changed;
# `d_devtools stop` ends it, `d_devtools status` shows it.
d_devtools() {
    _d_need_instance || return
    podman exec "$d_name" sh -c 'command -v chrome-devtools' >/dev/null 2>&1 \
        || { echo "d_devtools: no chrome-devtools in $d_name (it's in the image of d_distro=chrome d_target=canary)" >&2; return 1; }
    case ${1:-} in
        ''|-*|start|stop|status) ;;   # no daemon needed, or start with your own options
        *)  local _d_dt_opts want
            _d_devtools_opts
            want=$(printf '%s\n' "${_d_dt_opts[@]}")
            # the options the daemon was started with are kept in the instance's /tmp
            if [ "$(d_exec sh -c 'chrome-devtools status 2>&1 | grep -q "is running" && cat /tmp/d_devtools.opts 2>/dev/null')" != "$want" ]; then
                d_exec sh -c 'chrome-devtools start "$@" >/dev/null 2>&1 && printf "%s\n" "$@" > /tmp/d_devtools.opts' sh "${_d_dt_opts[@]}" \
                    || { echo "d_devtools: couldn't start the daemon in $d_name (is the browser up? d_chrome)" >&2; return 1; }
            fi ;;
    esac
    d_exec chrome-devtools "$@"
}
