ARG BASE=localhost/vnc-desktop-ubuntu:browser

# MATE desktop (d_target=mate), on a distro's browser stage (Chrome, the CLI installers,
# TigerVNC/noVNC, nested podman). One stage per distro that has it; d_build picks the
# stage named like d_distro, with BASE=localhost/vnc-desktop-<distro>:browser, and tags
# the image vnc-desktop-<distro>:mate. The build context is the repo root.
#   ubuntu - Ubuntu 26.04 + MATE

# ---------------------------------------------------------------------------------------
# Stage "ubuntu"
FROM ${BASE} AS ubuntu
USER root

# d_build passes these to every Containerfile. The user itself comes with the base image
# (as does ENV USERID), so they're unused here.
ARG USERID
ARG USER_UID

# scrot: tests/screenshot.sh (MATE's own mate-screenshot can only save through a dialog)
# keep list sorted
RUN apt-get update && apt-get install -y --no-install-recommends \
    mate-desktop-environment-core \
    mate-terminal \
    scrot \
    && { mountpoint -q /var/cache/apt-ubuntu || apt-get clean; } \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*.bin

# Panel layout: Ubuntu's default ("familiar") uses applets that aren't installed (they
# show as "Error" boxes, and the top panel stays empty); use MATE's own default. Only
# read when a home's panel is first set up.
RUN printf '#!/bin/sh\nexec mate-session\n' > /usr/local/bin/vnc-session \
    && printf '%s\n' '[org.mate.panel]' "default-layout='default'" \
        > /usr/share/glib-2.0/schemas/99_vnc-desktop.gschema.override \
    && glib-compile-schemas /usr/share/glib-2.0/schemas

USER ${USERID}
